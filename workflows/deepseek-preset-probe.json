{
  "schema_version": 1,
  "id": "deepseek-preset-probe",
  "name": "DeepSeek preset probe",
  "inputs": [],
  "agents": [],
  "nodes": [
    {
      "id": "t",
      "kind": "trigger",
      "type_version": 1,
      "name": "Probe",
      "config": {
        "trigger_kind": "manual"
      },
      "ports": [],
      "position": null
    },
    {
      "id": "probe",
      "kind": "agent",
      "type_version": 1,
      "name": "Say hello and self-report",
      "config": {
        "prompt": "Reply with exactly one line and nothing else, then stop. Do not use any tools. The line must be:\n\nPRESET_OK: <the model name you believe you are>"
      },
      "ports": [],
      "position": null
    }
  ],
  "edges": [
    {
      "from_node": "t",
      "from_port": "main",
      "to_node": "probe",
      "to_port": "main"
    }
  ],
  "description": "Minimal check that the customHarnesses preset id \"deepseek\" resolves on this host and the OpenRouter model answers.",
  "enabled": true,
  "defaults": {
    "harness": "deepseek",
    "model": "~deepseek/deepseek-v4-flash-latest"
  }
}