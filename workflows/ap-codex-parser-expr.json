{
  "schema_version": 1,
  "id": "ap-codex-parser-expr",
  "name": "ap-codex-parser-expr",
  "inputs": [
    {
      "name": "n",
      "type": "number",
      "description": "n",
      "required": false,
      "default": 1
    }
  ],
  "nodes": [
    {
      "id": "t",
      "kind": "trigger",
      "type_version": 1,
      "name": "go",
      "config": {
        "trigger_kind": "manual"
      },
      "ports": [],
      "position": null
    },
    {
      "id": "a",
      "kind": "agent",
      "type_version": 1,
      "name": "probe",
      "config": {
        "prompt": "=\"Reply with exactly: OK for issue \\(.inputs.n)\"",
        "output_parser": {
          "schema": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              }
            },
            "required": [
              "ok"
            ]
          }
        }
      },
      "ports": [],
      "position": null
    }
  ],
  "edges": [
    {
      "from_node": "t",
      "from_port": "main",
      "to_node": "a",
      "to_port": "main"
    }
  ],
  "description": "agent shape probe",
  "enabled": true,
  "defaults": {
    "harness": "codex"
  }
}