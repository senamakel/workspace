{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/work/workspace/bin/auto-commit\" --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /tmp/tmp.6n5yUUafjt/app/hooks/turn-end.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
