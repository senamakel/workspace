{
  "hooks": {
    "post_tool_use": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/work/workspace/bin/auto-commit\" --hook"
          }
        ]
      }
    ],
    "session_end": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/work/workspace/bin/auto-commit\" --hook"
          }
        ]
      }
    ],
    "subagent_stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/work/workspace/bin/auto-commit\" --hook"
          }
        ]
      }
    ]
  }
}
