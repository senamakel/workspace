# cortex/cortex.env — the fleet's CortexDB configuration.
#
# `bin/cortex-up` hands this file to `docker run --env-file`, so every box runs
# the same store the same way, the way `ladder/config.toml` makes every box's
# router the same. Docker copies it in at create time, and cortex-up hashes it
# into the container's spec label, so editing a line here and running cortex-up
# is a recreate — there is no "installed copy" to drift.
#
# It holds NO secret. `CORTEX_API_KEY` and every `*_API_KEY` the store needs
# are added by cortex-up from the box's own environment (`~/.zshenv`), because
# this repository is public. Do not put a key in this file.
#
# Format is docker's env-file, not a shell: one KEY=value per line, no quotes
# (they would become part of the value), no `$VAR` expansion.
#
# # Everything is ON
#
# A fresh CortexDB is deliberately vector-only: hybrid vector+BM25 recall and
# nothing else — no entity graph, no facts, no enrichment, no episodes or
# beliefs, no artifacts, no code plane, no document parsing. That is the shape
# its benchmarks were measured in, and every layer beyond it is a separate
# opt-in switch, most of which cost a model call per write. This file turns
# every one of them on that the fleet can actually serve, and says which one it
# cannot and why. The point of a *shared* cortex is that an agent on any box
# finds the same five layers live, not a store that has to be configured before
# it holds a fact.
#
# All the model traffic goes through the box's own ladder router on
# host.docker.internal:6969 — embeddings, extraction, enrichment, the answer
# writer and its verifier. One egress path, one set of provider keys, and the
# ladder names (`vectors`, `flash`, `reasoning`) mean the same thing on every
# box because `ladder/config.toml` is the same file everywhere.

# --- identity ----------------------------------------------------------------

# `dev_local`, the default, allows unsigned actors and is documented as never
# for production. `on_prem_enterprise` is the single-tenant preset for a store
# somebody else's process talks to over a network, which this is.
CORTEX_DEPLOYMENT_PRESET=on_prem_enterprise

# `POST /v1/auth/tokens`. Without CORTEX_V1_MINTER_KEY_DIR the minter uses an
# ephemeral keypair, so a minted token dies with the container; the bearer in
# CORTEX_API_KEY is what callers on the fleet actually use, and it does not.
CORTEX_V1_MINTER_ENABLE=1

# The community binary phones home an anonymous usage beacon by default. These
# are private boxes; opt out.
CORTEX_TELEMETRY=0

# --- embeddings ----------------------------------------------------------------
#
# The width is PINNED on first ingest and rejected forever after, and it must
# match what the ladder's `vectors` ladder returns — 1024, BGE-M3 (see the
# ladder config for why every rung of that ladder is the same width). A store
# created at another width does not get a wrong answer; it gets no vector
# index at all, silently: writes still 200, `wal_events` climbs, `vectors`
# stays still. Change this only together with the ladder, and only on a fresh
# volume.
CORTEX_EMBEDDING_URL=http://host.docker.internal:6969/v1
CORTEX_EMBEDDING_MODEL=vectors
CORTEX_EMBEDDING_DIMS=1024

# --- the retrieval-helper LLM (entity extraction, query classification) -------
CORTEX_LLM_URL=http://host.docker.internal:6969/v1
CORTEX_LLM_MODEL=flash

# --- enrichment: facts, and everything downstream of facts --------------------
#
# Unset means OFF, and off is not zero: it is the difference between a store
# that holds events and one that holds facts, beliefs and a graph. `60` is a
# WAL-cursor scan every minute — near-realtime without turning every write into
# an immediate model call. `flash` because this is one to two calls per job on
# every write, so it is what decides the cost of a busy corpus.
CORTEX_ENRICHMENT_DELAY_SECONDS=60
CORTEX_ENRICHMENT_URL=http://host.docker.internal:6969/v1
CORTEX_ENRICHMENT_MODEL=flash
# Default 16. The ladder fronts rate-limited providers and is shared with every
# agent on the box, so this is turned down rather than up.
CORTEX_ENRICHMENT_CONCURRENCY=4
# Demotes chunk vectors to cold storage once enrichment commits: flat RAM at
# any corpus size, recall at parity. The production checklist says always set.
CORTEX_EVICT_VECTORS_ON_ENRICH=1

# --- the synthesis scheduler: episodes, beliefs, concept reflection ----------
CORTEX_V1_LAYERS_AUTO=1

# --- the knowledge graph ------------------------------------------------------
CORTEX_ENTITY_GRAPH=1
CORTEX_ENTITY_GROUNDING=1
CORTEX_FACT_JOIN_MULTIHOP=1

# Time-travel facts. `shadow` (the default) runs the engine without changing
# what a fact says; `enforce` grounds t_valid_from/t_valid_to in stated
# world-time, which is what makes `GET /v1/claims?valid_as_of=` mean what it
# reads like.
CORTEX_BITEMPORAL_MODE=enforce

# --- artifacts: derived, queryable documents compiled from events -------------
# Workers are background model calls, so the count is a spend decision.
CORTEX_ARTIFACT_PIPELINE=1
CORTEX_ARTIFACT_WORKERS=2

# --- the code intelligence plane ---------------------------------------------
#
# Free when nothing is registered: no stores open and `/v1/code/*` answers 503
# until a repo is registered through the API. `vectors`, `rank` and
# `scip_auto` stay off because the vendor's own docs record them as
# measured-no-gain or explicitly-opt-in.
CORTEX_CODE_PLANE=1
CORTEX_CODE_BUNDLE=1
CORTEX_CODE_SHAPES=active
CORTEX_CODE_WATCH=1
CORTEX_CODE_VECTORS=0
CORTEX_CODE_RANK=0
CORTEX_CODE_SCIP_AUTO=0
CORTEX_CODE_OVERLAY_TTL_DAYS=7

# --- documents: PDF and DOCX through the Tika sidecar --------------------------
#
# Without a document provider CortexDB refuses the MIME type at ingest rather
# than storing the bytes unread. `tika` and `unstructured` are the only shapes
# it accepts and both are HTTP services, so cortex-up runs Apache Tika beside
# the store on a private docker network; `cortex-tika` is that container's name
# on it. Tika is on no published port and has no route off the host.
CORTEX_DOCUMENT_PROVIDER=tika
CORTEX_DOCUMENT_API_URL=http://cortex-tika:9998

# --- the answer writer and its verifier ---------------------------------------
#
# The image defaults these to api.anthropic.com and api.openai.com — a second
# egress path with a second set of provider keys. Pointed at the ladder
# instead. `openai` means OpenAI-*compatible*, which the ladder is; the
# default `anthropic` left in place with the URL moved to the ladder is the
# worst kind of misconfiguration, a provider speaking the Anthropic message
# protocol to an OpenAI-shaped endpoint, assembled entirely from valid-looking
# settings. `reasoning` rather than `flash` because these two run only when a
# caller asks for a written answer, and can afford the deeper ladder.
CORTEX_ANSWER_PROVIDER=openai
CORTEX_ANSWER_URL=http://host.docker.internal:6969/v1
CORTEX_ANSWER_MODEL=reasoning
CORTEX_ANSWER_MAX_TOKENS=1500
CORTEX_VERIFIER_URL=http://host.docker.internal:6969/v1
CORTEX_VERIFIER_MODEL=reasoning

# --- write path ---------------------------------------------------------------
# Bulk ingest acks after WAL + BM25 + content store and embeds in the
# background (10x the ack rate, per the vendor's evidence). Single-event writes
# keep the full synchronous pipeline.
CORTEX_BULK_DEFER_VECTORS=1

# --- recall -------------------------------------------------------------------
CORTEX_HYBRID_RERANK=1
# The cross-encoder second pass is the one feature this file cannot turn on by
# itself: it runs on Cohere's API (a second egress path) or on a local ONNX
# model the image does not ship. cortex-up enables the Cohere reranker when
# COHERE_API_KEY is exported on the box; with the key absent, recall is the
# hybrid vector+BM25 ranking the benchmarks were run with.
CORTEX_RERANKER_MODEL=rerank-v3.5
