#!/usr/bin/env bash
# pr-comments — list the unresolved review feedback on a pull request.
#
# Usage: pr-comments [<number>] [--json] [--all] [--include-outdated]
#                    [-R|--repo <owner/name>]
#
# Reports every unresolved review thread (file, line, and the full comment
# chain) plus any review still requesting changes. Each thread carries the
# threadId that pr-reply needs, and each review the reviewId that
# pr-review-resolve needs. --all also lists resolved threads and dismissed
# reviews; outdated threads are included by default because their feedback
# usually still applies. Human-readable output is the default; --json emits a
# stable document for agents. The current repository's upstream remote is
# preferred over origin. PR_COMMENTS_REPO can also override repository lookup.
set -euo pipefail

fail() {
  printf '[FAIL] %s\n' "$*" >&2
}

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'
}

require() {
  local bin
  for bin in "$@"; do
    command -v "$bin" >/dev/null 2>&1 \
      || { fail "missing required tool: $bin"; exit 1; }
  done
}

resolve_repo() {
  if [ -n "$REPO" ]; then
    printf '%s\n' "$REPO"
    return
  fi

  local url
  url=$(git remote get-url upstream 2>/dev/null || git remote get-url origin 2>/dev/null) \
    || { fail "no upstream or origin remote found"; exit 1; }
  printf '%s\n' "$url" \
    | sed -E 's#^git@github\.com:##; s#^https?://github\.com/##; s#\.git$##'
}

FORMAT="text"
INCLUDE_RESOLVED=0
PR=""
REPO="${PR_COMMENTS_REPO:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --json)
      FORMAT="json"
      shift
      ;;
    --all)
      INCLUDE_RESOLVED=1
      shift
      ;;
    --include-outdated)
      # Outdated threads are always included; accepted for explicitness.
      shift
      ;;
    -R|--repo)
      [ $# -ge 2 ] || { fail "$1 requires an owner/name value"; usage; exit 1; }
      REPO="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown argument: $1"
      usage
      exit 1
      ;;
    *)
      [ -z "$PR" ] || { fail "unexpected extra argument: $1"; usage; exit 1; }
      PR="$1"
      shift
      ;;
  esac
done

require gh jq
if [ -z "$REPO" ]; then
  require git
  git rev-parse --git-dir >/dev/null 2>&1 \
    || { fail "not inside a git repository; pass --repo owner/name"; exit 1; }
fi
REPO=$(resolve_repo)

# With no number, fall back to the pull request for the current branch so the
# command is usable mid-review without looking anything up.
if [ -z "$PR" ]; then
  PR=$(gh pr view -R "$REPO" --json number --jq .number 2>/dev/null) \
    || { fail "no pull request for the current branch; pass a PR number"; exit 1; }
fi
case "$PR" in
  ''|*[!0-9]*) fail "pull request number must be a positive integer"; exit 1 ;;
esac

OWNER="${REPO%%/*}"
NAME="${REPO##*/}"

THREADS=$(gh api graphql --paginate --slurp \
  -f owner="$OWNER" \
  -f name="$NAME" \
  -F number="$PR" \
  -f query='
    query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviewThreads(first: 50, after: $endCursor) {
            nodes {
              id
              isResolved
              isOutdated
              isCollapsed
              path
              line
              originalLine
              diffSide
              comments(first: 100) {
                nodes {
                  author { login }
                  body
                  url
                  createdAt
                }
              }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  ') || { fail "could not read review threads for PR #$PR"; exit 1; }

REVIEWS=$(gh api graphql --paginate --slurp \
  -f owner="$OWNER" \
  -f name="$NAME" \
  -F number="$PR" \
  -f query='
    query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviews(first: 50, after: $endCursor) {
            nodes {
              id
              state
              body
              url
              submittedAt
              author { login }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  ') || { fail "could not read reviews for PR #$PR"; exit 1; }

REPORT=$(jq -n \
  --arg repository "$REPO" \
  --argjson number "$PR" \
  --argjson includeResolved "$INCLUDE_RESOLVED" \
  --argjson threadPages "$THREADS" \
  --argjson reviewPages "$REVIEWS" '
  def compact_text:
    gsub("[[:space:]]+"; " ") | sub("^ "; "") | sub(" $"; "");

  [$threadPages[].data.repository.pullRequest.reviewThreads.nodes[]]
    as $allThreads
  | [$reviewPages[].data.repository.pullRequest.reviews.nodes[]]
    as $allReviews

  # A review only still demands action while it is that reviewer latest
  # verdict: a later APPROVED or DISMISSED review from the same author
  # supersedes an earlier CHANGES_REQUESTED.
  | [$allReviews[]
      | select(.state == "CHANGES_REQUESTED")
      | . as $review
      | select(
          [$allReviews[]
            | select((.author.login // "") == ($review.author.login // ""))
            | select(.submittedAt > $review.submittedAt)
            | select(.state == "APPROVED" or .state == "DISMISSED")]
          | length == 0
        )
    ] as $blockingReviews

  | {
      repository: $repository,
      pullRequest: $number,
      unresolvedThreads: ([$allThreads[] | select(.isResolved | not)] | length),
      changesRequested: ($blockingReviews | length),
      threads: [
        $allThreads[]
        | select(($includeResolved == 1) or (.isResolved | not))
        | {
            threadId: .id,
            isResolved,
            isOutdated,
            path,
            line: (.line // .originalLine),
            side: .diffSide,
            url: (.comments.nodes[0].url // null),
            comments: [
              .comments.nodes[] | {
                author: (.author.login // "ghost"),
                createdAt,
                body: (.body // ""),
                summary: ((.body // "") | compact_text
                  | if length <= 200 then . else .[0:199] + "…" end)
              }
            ]
          }
      ],
      reviews: [
        (if $includeResolved == 1 then $allReviews[] else $blockingReviews[] end)
        | {
            reviewId: .id,
            state,
            author: (.author.login // "ghost"),
            submittedAt,
            url,
            body: (.body // ""),
            summary: ((.body // "") | compact_text
              | if length == 0 then "(no review body)"
                elif length <= 200 then .
                else .[0:199] + "…" end)
          }
      ]
    }
') || { fail "could not summarize feedback for PR #$PR"; exit 1; }

if [ "$FORMAT" = "json" ]; then
  jq . <<<"$REPORT"
  exit 0
fi

jq -r '
  "Repository: \(.repository)",
  "Pull request: #\(.pullRequest)",
  "Unresolved threads: \(.unresolvedThreads); reviews requesting changes: \(.changesRequested)",
  (if (.threads | length) == 0 then "", "No matching review threads." else empty end),
  (.threads[] |
    "",
    "Thread \(.threadId)",
    "  File: \(.path // "(none)"):\(.line // "?")\(if .isOutdated then " (outdated)" else "" end)\(if .isResolved then " (resolved)" else "" end)",
    "  URL: \(.url // "(none)")",
    (.comments[] | "  - \(.author): \(.summary)")
  ),
  (if (.reviews | length) == 0 then empty else
    "",
    "Reviews:",
    (.reviews[] |
      "",
      "Review \(.reviewId)",
      "  \(.state) by \(.author) at \(.submittedAt)",
      "  URL: \(.url)",
      "  Body: \(.summary)"
    )
   end)
' <<<"$REPORT"
