#!/usr/bin/env bash
# pr-comments — list the unresolved review feedback on a pull request.
#
# Usage: pr-comments [<number>] [--json] [--all] [--threads-only]
#                    [--from <login>]... [-R|--repo <owner/name>]
#
# Collects feedback from all three channels GitHub splits it across, so review
# bots (coderabbitai, chatgpt-codex-connector, greptile-apps) are covered
# wherever they post:
#   threads  inline review threads — the only resolvable kind; each carries the
#            threadId pr-reply needs, and unresolved ones are listed by default
#   reviews  review-level bodies (summaries and verdicts); each carries the
#            reviewId pr-review-resolve needs
#   comments top-level pull request comments
#
# Only threads have a resolved state, so reviews and comments are always
# listed; --threads-only narrows output to the resolvable threads. --all also
# lists resolved threads and superseded reviews. Outdated threads are included
# by default because their feedback usually still applies. --from limits every
# section to the given author and may be repeated. Human-readable output is the
# default; --json emits full comment bodies for agents. The current
# repository's upstream remote is preferred over origin. PR_COMMENTS_REPO can
# also override repository lookup.
set -euo pipefail

fail() {
  printf '[FAIL] %s\n' "$*" >&2
}

usage() {
  sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
}

require() {
  local bin
  for bin in "$@"; do
    command -v "$bin" >/dev/null 2>&1 \
      || { fail "missing required tool: $bin"; exit 1; }
  done
}

resolve_repo() {
  if [ -n "$REPO" ]; then
    printf '%s\n' "$REPO"
    return
  fi

  local url
  url=$(git remote get-url upstream 2>/dev/null || git remote get-url origin 2>/dev/null) \
    || { fail "no upstream or origin remote found"; exit 1; }
  printf '%s\n' "$url" \
    | sed -E 's#^git@github\.com:##; s#^https?://github\.com/##; s#\.git$##'
}

FORMAT="text"
INCLUDE_RESOLVED=0
THREADS_ONLY=0
PR=""
REPO="${PR_COMMENTS_REPO:-}"
AUTHORS="[]"

while [ $# -gt 0 ]; do
  case "$1" in
    --json)
      FORMAT="json"
      shift
      ;;
    --all)
      INCLUDE_RESOLVED=1
      shift
      ;;
    --threads-only)
      THREADS_ONLY=1
      shift
      ;;
    --from)
      [ $# -ge 2 ] || { fail "--from requires a login"; usage; exit 1; }
      AUTHORS=$(jq -c --arg login "$2" '. + [$login]' <<<"$AUTHORS")
      shift 2
      ;;
    -R|--repo)
      [ $# -ge 2 ] || { fail "$1 requires an owner/name value"; usage; exit 1; }
      REPO="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      fail "unknown argument: $1"
      usage
      exit 1
      ;;
    *)
      [ -z "$PR" ] || { fail "unexpected extra argument: $1"; usage; exit 1; }
      PR="$1"
      shift
      ;;
  esac
done

require gh jq
if [ -z "$REPO" ]; then
  require git
  git rev-parse --git-dir >/dev/null 2>&1 \
    || { fail "not inside a git repository; pass --repo owner/name"; exit 1; }
fi
REPO=$(resolve_repo)

# With no number, fall back to the pull request for the current branch so the
# command is usable mid-review without looking anything up.
if [ -z "$PR" ]; then
  PR=$(gh pr view -R "$REPO" --json number --jq .number 2>/dev/null) \
    || { fail "no pull request for the current branch; pass a PR number"; exit 1; }
fi
case "$PR" in
  ''|*[!0-9]*) fail "pull request number must be a positive integer"; exit 1 ;;
esac

OWNER="${REPO%%/*}"
NAME="${REPO##*/}"

# Each connection is paginated separately: gh --paginate drives one cursor at a
# time, and a PR with a busy bot can exceed one page on any of the three.
THREADS=$(gh api graphql --paginate --slurp \
  -f owner="$OWNER" \
  -f name="$NAME" \
  -F number="$PR" \
  -f query='
    query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviewThreads(first: 50, after: $endCursor) {
            nodes {
              id
              isResolved
              isOutdated
              path
              line
              originalLine
              diffSide
              comments(first: 100) {
                nodes {
                  author { login }
                  body
                  url
                  createdAt
                }
              }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  ') || { fail "could not read review threads for PR #$PR"; exit 1; }

REVIEWS=$(gh api graphql --paginate --slurp \
  -f owner="$OWNER" \
  -f name="$NAME" \
  -F number="$PR" \
  -f query='
    query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          reviews(first: 50, after: $endCursor) {
            nodes {
              id
              state
              body
              url
              submittedAt
              author { login }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  ') || { fail "could not read reviews for PR #$PR"; exit 1; }

COMMENTS=$(gh api graphql --paginate --slurp \
  -f owner="$OWNER" \
  -f name="$NAME" \
  -F number="$PR" \
  -f query='
    query($owner: String!, $name: String!, $number: Int!, $endCursor: String) {
      repository(owner: $owner, name: $name) {
        pullRequest(number: $number) {
          comments(first: 50, after: $endCursor) {
            nodes {
              id
              body
              url
              createdAt
              author { login }
            }
            pageInfo { hasNextPage endCursor }
          }
        }
      }
    }
  ') || { fail "could not read pull request comments for PR #$PR"; exit 1; }

REPORT=$(jq -n \
  --arg repository "$REPO" \
  --argjson number "$PR" \
  --argjson includeResolved "$INCLUDE_RESOLVED" \
  --argjson threadsOnly "$THREADS_ONLY" \
  --argjson authors "$AUTHORS" \
  --argjson threadPages "$THREADS" \
  --argjson reviewPages "$REVIEWS" \
  --argjson commentPages "$COMMENTS" '
  def compact_text:
    gsub("[[:space:]]+"; " ") | sub("^ "; "") | sub(" $"; "");
  def summarize:
    (. // "" | compact_text)
    | if length == 0 then "(no body)"
      elif length <= 200 then .
      else .[0:199] + "…"
      end;
  def by_author($login):
    ($authors | length) == 0 or ($authors | index($login) != null);

  [$threadPages[].data.repository.pullRequest.reviewThreads.nodes[]]
    as $allThreads
  | [$reviewPages[].data.repository.pullRequest.reviews.nodes[]]
    as $allReviews
  | [$commentPages[].data.repository.pullRequest.comments.nodes[]]
    as $allComments

  # A review still demands action while it is that reviewer latest verdict: a
  # later APPROVED or DISMISSED review by the same author supersedes an earlier
  # CHANGES_REQUESTED.
  | [$allReviews[]
      | select(.state == "CHANGES_REQUESTED")
      | . as $review
      | select(
          [$allReviews[]
            | select((.author.login // "") == ($review.author.login // ""))
            | select(.submittedAt > $review.submittedAt)
            | select(.state == "APPROVED" or .state == "DISMISSED")]
          | length == 0
        )
    ] as $blockingReviews
  | ($blockingReviews | map(.id)) as $blockingIds

  | {
      repository: $repository,
      pullRequest: $number,
      unresolvedThreads: ([$allThreads[] | select(.isResolved | not)] | length),
      changesRequested: ($blockingReviews | length),
      threads: [
        $allThreads[]
        | select(($includeResolved == 1) or (.isResolved | not))
        | select(by_author(.comments.nodes[0].author.login // "ghost"))
        | {
            threadId: .id,
            isResolved,
            isOutdated,
            path,
            line: (.line // .originalLine),
            side: .diffSide,
            url: (.comments.nodes[0].url // null),
            comments: [
              .comments.nodes[] | {
                author: (.author.login // "ghost"),
                createdAt,
                body: (.body // ""),
                summary: (.body | summarize)
              }
            ]
          }
      ],
      # Review bodies carry the bot summaries (greptile and codex post their
      # findings here, not only inline), so they are listed whatever the state.
      # Empty-bodied reviews are dropped: they are the envelope for inline
      # comments already reported under threads.
      reviews: (if $threadsOnly == 1 then [] else [
        $allReviews[]
        | select(($includeResolved == 1)
                 or (.state != "DISMISSED")
                 and ((.state != "CHANGES_REQUESTED")
                      or (.id | IN($blockingIds[]))))
        | select(($includeResolved == 1)
                 or ((.body // "" | compact_text | length) > 0))
        | select(by_author(.author.login // "ghost"))
        | {
            reviewId: .id,
            state,
            blocking: (.id | IN($blockingIds[])),
            author: (.author.login // "ghost"),
            submittedAt,
            url,
            body: (.body // ""),
            summary: (.body | summarize)
          }
      ] end),
      comments: (if $threadsOnly == 1 then [] else [
        $allComments[]
        | select(by_author(.author.login // "ghost"))
        | {
            commentId: .id,
            author: (.author.login // "ghost"),
            createdAt,
            url,
            body: (.body // ""),
            summary: (.body | summarize)
          }
      ] end)
    }
') || { fail "could not summarize feedback for PR #$PR"; exit 1; }

if [ "$FORMAT" = "json" ]; then
  jq . <<<"$REPORT"
  exit 0
fi

jq -r '
  "Repository: \(.repository)",
  "Pull request: #\(.pullRequest)",
  "Unresolved threads: \(.unresolvedThreads); reviews requesting changes: \(.changesRequested)",
  "Feedback: \(.threads | length) thread(s), \(.reviews | length) review(s), \(.comments | length) comment(s)",
  (if (.threads | length) == 0 then "", "No matching review threads." else empty end),
  (.threads[] |
    "",
    "Thread \(.threadId)",
    "  File: \(.path // "(none)"):\(.line // "?")\(if .isOutdated then " (outdated)" else "" end)\(if .isResolved then " (resolved)" else "" end)",
    "  URL: \(.url // "(none)")",
    (.comments[] | "  - \(.author): \(.summary)")
  ),
  (if (.reviews | length) == 0 then empty else
    "",
    "Reviews:",
    (.reviews[] |
      "",
      "Review \(.reviewId)",
      "  \(.state)\(if .blocking then " (blocking)" else "" end) by \(.author) at \(.submittedAt)",
      "  URL: \(.url)",
      "  Body: \(.summary)"
    )
   end),
  (if (.comments | length) == 0 then empty else
    "",
    "Comments:",
    (.comments[] |
      "",
      "Comment by \(.author) at \(.createdAt)",
      "  URL: \(.url)",
      "  Body: \(.summary)"
    )
   end)
' <<<"$REPORT"
