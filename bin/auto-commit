#!/usr/bin/env bash
# auto-commit — commit whatever is dirty, with a message written from the diff.
#
# Usage: auto-commit [--hook] [--now] [--dry-run] [--json]
#
#   auto-commit --now        commit the working tree right now
#   auto-commit --dry-run    show the message and the files, commit nothing
#   auto-commit --hook       read a Claude Code PostToolUse event on stdin and
#                            commit once every AUTO_COMMIT_EVERY tool calls
#
# Wired as a PostToolUse hook, this keeps work committed continuously instead of
# relying on an agent to remember. Every AUTO_COMMIT_EVERY tool calls it collects
# the changed and untracked files, asks a cheap model for a subject line and a
# short description of what changed, and commits through `atomic-commit`. It
# never pushes.
#
# Because the hook does the committing, agents no longer need a rule telling
# them to commit after every step — which is why RULES.md no longer carries one.
#
# The counter is per session and per repository, so two sessions in two
# checkouts do not trip each other's commits.
#
# These commits are working checkpoints, not curated history: they take whatever
# is dirty at the moment they fire, which may span more than one concern. Use
# `atomic-commit` for scoped commits, and expect to squash a branch built this
# way before review.
#
# Guards, all deliberate:
#   * refuses on a protected branch (main/master) unless allowed, because new
#     work is supposed to happen on a feature branch
#   * never stages a path that looks like a credential, whatever .gitignore says
#   * does nothing during a merge, rebase, cherry-pick, or bisect
#   * commits without a model, and without a network, if it has to
#
# Overridable:
# There is deliberately no environment switch to turn this off. A kill switch is
# the first thing reached for when committing is inconvenient, which is exactly
# when checkpoints matter most. Disabling it takes a deliberate, visible edit to
# claude/settings.json or codex/hooks.json. The guards below are not opt-outs:
# they exist so the command never commits something it should not.
#
#   AUTO_COMMIT_EVERY                tool calls between commits (3)
#   AUTO_COMMIT_ALLOW_PROTECTED=1    allow commits on main/master
#   AUTO_COMMIT_PROTECTED            protected branch names (main master)
#   AUTO_COMMIT_SKIP                 extra glob(s) never staged, colon-separated
#   AUTO_COMMIT_FALLBACK_TYPE        type used when the model gives none (chore)
#   AUTO_COMMIT_FALLBACK_MAX_FILES   files named in the fallback subject (5)
#   AUTO_COMMIT_TIMEOUT              seconds allowed for the subject line (5)
#   AUTO_COMMIT_TYPES                accepted Conventional Commits types
#   AUTO_COMMIT_MODEL                model id (deepseek/deepseek-v4-flash)
#   AUTO_COMMIT_URL                  chat-completions endpoint
#   AUTO_COMMIT_API_KEY_VAR          env var holding the key (OPENROUTER_API_KEY)
#   AUTO_COMMIT_CMD                  call this CLI instead of the API (tests)
#   AUTO_COMMIT_MAX_DIFF             bytes of diff sent to the model (40000)
#   AUTO_COMMIT_BODY_MAX_LINES       description lines kept from the model (6)
set -euo pipefail

fail() { printf '[FAIL] %s\n' "$*" >&2; }
usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }

HOOK=0
NOW=0
DRY=0
FORMAT="text"

while [ $# -gt 0 ]; do
  case "$1" in
    --hook)    HOOK=1; shift ;;
    --now)     NOW=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --json)    FORMAT="json"; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         fail "unknown argument: $1"; usage; exit 1 ;;
  esac
done

[ "$HOOK" = "1" ] || [ "$NOW" = "1" ] || [ "$DRY" = "1" ] || { usage; exit 1; }

EVERY="${AUTO_COMMIT_EVERY:-3}"
# Conventional Commits: the subject is `type(scope): description`. Anything the
# model returns in another shape gets the fallback type rather than being thrown
# away, so the log stays parseable without losing a description that read the diff.
CONVENTIONAL_TYPES="${AUTO_COMMIT_TYPES:-feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert}"
FALLBACK_TYPE="${AUTO_COMMIT_FALLBACK_TYPE:-chore}"
FALLBACK_MAX_FILES="${AUTO_COMMIT_FALLBACK_MAX_FILES:-5}"
BODY_MAX_LINES="${AUTO_COMMIT_BODY_MAX_LINES:-6}"
# Five seconds is the whole budget for the subject line. Past that the commit
# matters more than the wording: a checkpoint that arrives late is a checkpoint
# the next tool call has already raced, so it falls back to naming the files.
TIMEOUT="${AUTO_COMMIT_TIMEOUT:-5}"
MAX_DIFF="${AUTO_COMMIT_MAX_DIFF:-40000}"
MODEL="${AUTO_COMMIT_MODEL:-deepseek/deepseek-v4-flash}"
API_URL="${AUTO_COMMIT_URL:-https://openrouter.ai/api/v1/chat/completions}"
API_KEY_VAR="${AUTO_COMMIT_API_KEY_VAR:-OPENROUTER_API_KEY}"
CRITIC_CMD="${AUTO_COMMIT_CMD:-}"

note() { [ "$HOOK" = "1" ] || printf '%s\n' "$*"; }

# ── Where are we ───────────────────────────────────────────────────
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
TOP="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --absolute-git-dir)"

# ── Tool-call counter ──────────────────────────────────────────────
# PostToolUse fires on every tool call. Only every Nth one does any work, so the
# other N-1 cost a counter increment and nothing else.
if [ "$HOOK" = "1" ]; then
  command -v jq >/dev/null 2>&1 || exit 0
  EVENT="$(cat)"
  SESSION="$(printf '%s' "$EVENT" | jq -r '.session_id // "nosession"' 2>/dev/null || echo nosession)"
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/auto-commit"
  mkdir -p "$STATE_DIR"
  KEY="$(printf '%s:%s' "$SESSION" "$TOP" | shasum | cut -c1-32)"
  COUNT_FILE="$STATE_DIR/$KEY"
  COUNT="$(cat "$COUNT_FILE" 2>/dev/null || echo 0)"
  COUNT=$((COUNT + 1))
  if [ "$COUNT" -lt "$EVERY" ]; then
    printf '%s\n' "$COUNT" > "$COUNT_FILE"
    exit 0
  fi
  printf '0\n' > "$COUNT_FILE"
fi

emit() {
  local status="$1" detail="$2" files="${3:-}"
  if [ "$FORMAT" = "json" ]; then
    jq -n --arg status "$status" --arg detail "$detail" --arg files "$files" \
      '{status: $status, detail: $detail, files: ($files | split("\n") | map(select(length > 0)))}'
  else
    note "[$(printf '%s' "$status" | tr 'a-z' 'A-Z')] $detail"
    [ -z "$files" ] || note "$files"
  fi
}

# ── Guards ─────────────────────────────────────────────────────────
for marker in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD BISECT_LOG rebase-merge rebase-apply; do
  if [ -e "$GIT_DIR/$marker" ]; then
    emit skipped "a $marker operation is in progress"
    exit 0
  fi
done

BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$BRANCH" ]; then
  emit skipped "detached HEAD"
  exit 0
fi
if [ "${AUTO_COMMIT_ALLOW_PROTECTED:-0}" != "1" ]; then
  for protected in ${AUTO_COMMIT_PROTECTED:-main master}; do
    if [ "$BRANCH" = "$protected" ]; then
      # New work belongs on a feature branch; silently checkpointing onto main
      # would quietly break that rule several times a minute.
      emit skipped "on protected branch '$BRANCH' (AUTO_COMMIT_ALLOW_PROTECTED=1 to override)"
      exit 0
    fi
  done
fi

# ── What changed ───────────────────────────────────────────────────
# --porcelain omits ignored files, so build artifacts never appear here.
CHANGED=()
while IFS= read -r -d '' entry; do
  path="${entry:3}"
  # Renames read "R  old -> new"; the new path is what needs staging.
  case "$entry" in
    R*|C*) path="${path##* -> }" ;;
  esac
  [ -n "$path" ] && CHANGED+=("$path")
done < <(git status --porcelain -z 2>/dev/null || true)

if [ "${#CHANGED[@]}" -eq 0 ]; then
  emit clean "nothing to commit"
  exit 0
fi

# ── Never stage a credential ───────────────────────────────────────
# .gitignore is the usual defence, but this command stages files nobody
# reviewed first, so it keeps its own list rather than trusting the repo's.
SECRET_GLOBS=(
  '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.keystore' '*.jks'
  'id_rsa*' 'id_ed25519*' '*.ppk' '*credentials*' '*secret*' '*.kdbx'
  '.npmrc' '.netrc' '*.token'
)
# Bash 3.2, which is what macOS ships, treats an empty array as unbound under
# `set -u`, so the caller's extra globs are appended rather than expanded beside
# the defaults.
if [ -n "${AUTO_COMMIT_SKIP:-}" ]; then
  while IFS= read -r glob; do
    [ -z "$glob" ] || SECRET_GLOBS+=("$glob")
  done < <(printf '%s' "$AUTO_COMMIT_SKIP" | tr ':' '\n')
fi

STAGE=()
SKIPPED=()
for path in "${CHANGED[@]}"; do
  base="$(basename "$path")"
  secret=0
  for glob in "${SECRET_GLOBS[@]}"; do
    [ -n "$glob" ] || continue
    # shellcheck disable=SC2053
    if [[ "$base" == $glob || "$path" == $glob ]]; then secret=1; break; fi
  done
  if [ "$secret" = "1" ]; then SKIPPED+=("$path"); else STAGE+=("$path"); fi
done

if [ "${#SKIPPED[@]}" -gt 0 ]; then
  emit warned "not staging $(printf '%s ' "${SKIPPED[@]}")— looks like a credential"
fi
if [ "${#STAGE[@]}" -eq 0 ]; then
  emit clean "nothing to commit after credential filtering"
  exit 0
fi

# ── Write the message ──────────────────────────────────────────────
STAT="$(git diff HEAD --stat -- "${STAGE[@]}" 2>/dev/null || true)"
DIFF="$(git diff HEAD -- "${STAGE[@]}" 2>/dev/null | head -c "$MAX_DIFF" || true)"
# An untracked file has no diff against HEAD; name it so the model still sees it.
UNTRACKED="$(git ls-files --others --exclude-standard -- "${STAGE[@]}" 2>/dev/null || true)"

# Without a model this still commits — a checkpoint with a dull message beats a
# lost checkpoint.
fallback_subject() {
  local n="${#STAGE[@]}" list rest
  list="$(printf '%s\n' "${STAGE[@]}" | head -"$FALLBACK_MAX_FILES" | paste -sd, - || true)"
  if [ "$n" -gt "$FALLBACK_MAX_FILES" ]; then
    rest=$((n - FALLBACK_MAX_FILES))
    list="$list +$rest more"
  fi
  printf '%s: files changed %s' "$FALLBACK_TYPE" "$list"
}

# With no model there is nothing to summarise from, so the body just names what
# was committed — still more use to a reader than an empty description.
fallback_body() {
  printf 'Files changed:\n'
  printf -- '- %s\n' "${STAGE[@]}"
}

# Run a command with a wall-clock bound. curl bounds itself with --max-time, but
# an arbitrary AUTO_COMMIT_CMD does not, and macOS ships no `timeout`.
run_bounded() {
  local secs="$1"; shift
  local tmp pid ticks=0
  tmp="$(mktemp)"
  ( "$@" >"$tmp" 2>/dev/null ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$((secs * 10))" ]; then
      kill -9 "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rm -f "$tmp"
      return 1
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done
  wait "$pid" 2>/dev/null || { rm -f "$tmp"; return 1; }
  cat "$tmp"
  rm -f "$tmp"
}

ask_model() {
  local prompt payload
  prompt="$(cat <<EOF
Write a Conventional Commits message for the change below.

Format — a subject line, one blank line, then 1 to $BODY_MAX_LINES bullets:

type(scope): short description

- what changed and why, one bullet per distinct change

Rules for the subject:
- format: type(scope): description — the scope is optional
- type is one of: feat fix chore docs refactor test perf build ci style revert
- pick the type from what the change does: a new capability is feat, a bug fix is
  fix, documentation is docs, restructuring with no behaviour change is refactor,
  tests are test, and anything else routine is chore
- imperative mood, lower case description, no trailing period
- at most 72 characters

Rules for the bullets:
- start each with "- "
- say what changed and, where it is not obvious, why
- describe behaviour, not which files moved
- keep each under 100 characters; omit bullets entirely for a trivial change

Output the message and nothing else — no code fences, no preamble.

Files:
$(printf '%s\n' "${STAGE[@]}")

Untracked among them:
${UNTRACKED:-none}

Stat:
$STAT

Diff:
$DIFF
EOF
)"
  if [ -n "$CRITIC_CMD" ]; then
    run_bounded "$TIMEOUT" "$CRITIC_CMD" -p "$prompt"
    return
  fi
  [ -n "${!API_KEY_VAR:-}" ] || return 1
  # Reasoning off, deliberately. This question does not need deliberation, and
  # leaving it on doubles the wait (3.3s vs 1.7s measured) while consuming the
  # token budget before any content is emitted — the reason an answer-sized
  # budget came back empty every time.
  payload="$(jq -n --arg model "$MODEL" --arg content "$prompt" \
    '{model: $model, temperature: 0, max_tokens: 300,
      reasoning: {enabled: false},
      messages: [{role: "user", content: $content}]}')"
  curl -sS --fail-with-body --max-time "$TIMEOUT" --connect-timeout "$TIMEOUT" \
    -H "Authorization: Bearer ${!API_KEY_VAR}" \
    -H "Content-Type: application/json" \
    -d "$payload" "$API_URL" \
    | jq -r '.choices[0].message.content // ""'
}

RESPONSE="$(ask_model 2>/dev/null || true)"
SUBJECT="$(printf '%s\n' "$RESPONSE" | head -1 \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'"'"']//;s/["'"'"']$//')"
# Everything after the subject is the description. Blank lines and any stray code
# fence are dropped, and it is capped so a chatty model cannot bloat the log.
# The `|| true` matters: grep exits 1 when it filters everything away — which is
# exactly what happens when the model returns only a subject line — and pipefail
# would turn that into a silent exit before anything is committed.
BODY="$(printf '%s\n' "$RESPONSE" | tail -n +2 \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
  | { grep -v '^```' || true; } | { grep -v '^$' || true; } \
  | head -"$BODY_MAX_LINES" || true)"

if [ -z "$SUBJECT" ]; then
  SUBJECT="$(fallback_subject)"
  BODY="$(fallback_body)"
elif ! printf '%s' "$SUBJECT" \
  | grep -qE "^($CONVENTIONAL_TYPES)(\([^)]+\))?!?: .+"; then
  # The model answered, but not in Conventional Commits form. Keep what it said —
  # it read the diff — and give it the routine type rather than discarding it.
  SUBJECT="$FALLBACK_TYPE: $SUBJECT"
fi
SUBJECT="$(printf '%s' "$SUBJECT" | cut -c1-100)"
[ -n "$BODY" ] || BODY="$(fallback_body)"

# Subject, blank line, description — the shape git and every tool expect.
MESSAGE="$(printf '%s\n\n%s\n' "$SUBJECT" "$BODY")"

FILE_LIST="$(printf '%s\n' "${STAGE[@]}")"

if [ "$DRY" = "1" ]; then
  emit dry-run "$SUBJECT" "$(printf '%s\n---\n%s' "$BODY" "$FILE_LIST")"
  exit 0
fi

# ── Commit ─────────────────────────────────────────────────────────
# Hand the vetted paths to atomic-commit rather than staging here: it unstages
# everything else first without discarding it, so a credential this command
# refused to touch cannot ride along on an index someone else left dirty. Paths
# came from `git status` and are relative to the top level, so run it there —
# atomic-commit resolves its arguments against the current prefix.
ATOMIC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/atomic-commit"
if [ ! -x "$ATOMIC" ]; then
  emit skipped "atomic-commit not found beside this command"
  exit 0
fi
if ! OUTPUT="$(cd "$TOP" && "$ATOMIC" "$MESSAGE" -- "${STAGE[@]}" 2>&1)"; then
  # A rejected path, a whitespace error, nothing actually staged. Never fatal:
  # the working tree is untouched and the next tick tries again.
  emit skipped "atomic-commit refused: $(printf '%s' "$OUTPUT" | head -2 | tr '\n' ' ')"
  exit 0
fi

emit committed "$SUBJECT" "$FILE_LIST"
exit 0
