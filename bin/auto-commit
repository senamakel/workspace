#!/usr/bin/env bash
# auto-commit — commit whatever is dirty, with a message written from the diff.
#
# Usage: auto-commit [--hook] [--now] [--dry-run] [--json]
#
#   auto-commit --now        commit the working tree right now
#   auto-commit --dry-run    show the message and the files, commit nothing
#   auto-commit --hook       read a Claude Code PostToolUse event on stdin and
#                            commit once every AUTO_COMMIT_EVERY tool calls (1)
#
# Wired as a PostToolUse hook, this keeps work committed continuously instead of
# relying on an agent to remember. Every AUTO_COMMIT_EVERY tool calls (1 by
# default, so every call) it collects
# the changed and untracked files, asks a cheap model for a subject line and a
# short description of what changed, and commits through `atomic-commit`. It
# never pushes.
#
# Because the hook does the committing, agents no longer need a rule telling
# them to commit after every step — which is why RULES.md no longer carries one.
#
# The counter is per session and per repository, so two sessions in two
# checkouts do not trip each other's commits.
#
# These commits are working checkpoints, not curated history: they take whatever
# is dirty at the moment they fire, which may span more than one concern. Use
# `atomic-commit` for scoped commits, and expect to squash a branch built this
# way before review.
#
# Guards, all deliberate:
#   * commits only in repositories on the allowlist, because the message is
#     written by sending the diff to a third-party model
#   * refuses on a detached HEAD, where a commit would be unreachable
#   * never stages a path that looks like a credential, whatever .gitignore says
#   * bails on any merge conflict — an unmerged index or leftover conflict
#     markers — rather than checkpointing a half-resolved merge
#   * does nothing during a merge, rebase, cherry-pick, or bisect
#   * commits without a model, and without a network, if it has to
#
# Every commit it makes carries an `Auto-committed-on: <machine>` trailer, so a
# checkpoint is always distinguishable from a hand-written commit, and from the
# box it was made on.
#
# Overridable:
# There is deliberately no environment switch to turn this off. A kill switch is
# the first thing reached for when committing is inconvenient, which is exactly
# when checkpoints matter most. Disabling it takes a deliberate, visible edit to
# claude/settings.json or codex/hooks.json. The guards below are not opt-outs:
# they exist so the command never commits something it should not.
#
#   AUTO_COMMIT_EVERY                tool calls between commits (1 = every call)
#   AUTO_COMMIT_REPOS                allowlisted owner/repo slugs, colon-separated
#   AUTO_COMMIT_REMOTES              remotes consulted for the slug (origin upstream)
#   AUTO_COMMIT_SKIP                 extra glob(s) never staged, colon-separated
#   AUTO_COMMIT_SCAN_CONTENT=0       skip the credential content scan
#   AUTO_COMMIT_SECRET_PATTERNS      extra "name|regex" pairs, colon-separated
#   AUTO_COMMIT_FALLBACK_TYPE        type used when the model gives none (chore)
#   AUTO_COMMIT_FALLBACK_MAX_FILES   files named in the fallback subject (5)
#   AUTO_COMMIT_TIMEOUT              seconds allowed for the subject line (5)
#   AUTO_COMMIT_TYPES                accepted Conventional Commits types
#   AUTO_COMMIT_MODEL                model id (deepseek/deepseek-v4-flash)
#   AUTO_COMMIT_URL                  chat-completions endpoint
#   AUTO_COMMIT_API_KEY_VAR          env var holding the key (OPENROUTER_API_KEY)
#   AUTO_COMMIT_CMD                  call this CLI instead of the API (tests)
#   AUTO_COMMIT_DEVICE               name in the trailer (default: this hostname)
#   AUTO_COMMIT_DEVICE_FILE          file holding that name (~/.config/workspace/device)
#   AUTO_COMMIT_MAX_DIFF             bytes of diff sent to the model (40000)
#   AUTO_COMMIT_BODY_MAX_LINES       description lines kept from the model (6)
#   AUTO_COMMIT_LOG                  append a line per run here, `off` to disable
#                                    (/tmp/autocommit-error.log)
#   AUTO_COMMIT_LOG_ALL=1            also log the runs that found nothing to do
#   AUTO_COMMIT_LOG_MAX_BYTES        size at which the log is halved (1048576)
set -euo pipefail

fail() { printf '[FAIL] %s\n' "$*" >&2; }

# ── The log ────────────────────────────────────────────────────────
# In hook mode this command is silent by design: every refusal above returns
# exit 0 with `note` muted, so a checkpoint that never happens looks exactly
# like a checkpoint that was not needed. That is fine for the working case and
# useless the moment it stops committing, which is why every run also lands in
# a file. One line per run, saying which guard it stopped at and where.
LOG_FILE="${AUTO_COMMIT_LOG:-/tmp/autocommit-error.log}"
LOG_MAX_BYTES="${AUTO_COMMIT_LOG_MAX_BYTES:-1048576}"
LOG_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/auto-commit/last-log"
mkdir -p "$(dirname -- "$LOG_STATE")" 2>/dev/null || true
LOG_REPO="-"
LOG_BRANCH="-"
LOG_TOOL="-"

# Nothing here may abort the run: the log exists to explain failures, so a
# failure to log must never become one. Every step is best-effort.
log_event() {
  local status="$1" detail="${2:-}" extra="${3:-}" size dir stamp fingerprint last
  [ -n "$LOG_FILE" ] && [ "$LOG_FILE" != "off" ] || return 0
  dir="$(dirname -- "$LOG_FILE")"
  [ -d "$dir" ] || mkdir -p "$dir" 2>/dev/null || return 0

  # This runs on every tool call, so an unchanging condition — a repository off
  # the allowlist, a missing tool — would otherwise write the same line
  # hundreds of times and bury the one run that failed differently. Consecutive
  # repeats of the same outcome in the same repository are recorded once.
  fingerprint="$(printf '%s|%s|%s' "$LOG_REPO" "$status" "$detail" | shasum 2>/dev/null | cut -d' ' -f1 || true)"
  if [ -n "$fingerprint" ]; then
    last="$(cat "$LOG_STATE" 2>/dev/null || true)"
    [ "$fingerprint" != "$last" ] || return 0
    printf '%s\n' "$fingerprint" >"$LOG_STATE" 2>/dev/null || true
  fi

  # Halve the file rather than truncating it: the run that broke things is
  # usually a few runs back, and losing all of the history to a size cap would
  # throw away exactly the context worth reading.
  size="$(wc -c <"$LOG_FILE" 2>/dev/null || echo 0)"
  if [ "${size:-0}" -gt "$LOG_MAX_BYTES" ] 2>/dev/null; then
    if tail -c "$((LOG_MAX_BYTES / 2))" "$LOG_FILE" >"$LOG_FILE.tmp" 2>/dev/null; then
      mv -f "$LOG_FILE.tmp" "$LOG_FILE" 2>/dev/null || rm -f "$LOG_FILE.tmp" 2>/dev/null || true
    else
      rm -f "$LOG_FILE.tmp" 2>/dev/null || true
    fi
  fi
  stamp="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo '?')"
  {
    printf '%s pid=%s tool=%s repo=%s branch=%s %s: %s\n' \
      "$stamp" "$$" "$LOG_TOOL" "$LOG_REPO" "$LOG_BRANCH" "$status" \
      "$(printf '%s' "$detail" | tr '\n' ' ')"
    [ -z "$extra" ] || printf '%s\n' "$extra" | sed 's/^/    /'
  } >>"$LOG_FILE" 2>/dev/null || true
}
usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; }

HOOK=0
NOW=0
DRY=0
FORMAT="text"

while [ $# -gt 0 ]; do
  case "$1" in
    --hook)    HOOK=1; shift ;;
    --now)     NOW=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --json)    FORMAT="json"; shift ;;
    -h|--help) usage; exit 0 ;;
    *)         fail "unknown argument: $1"; usage; exit 1 ;;
  esac
done

[ "$HOOK" = "1" ] || [ "$NOW" = "1" ] || [ "$DRY" = "1" ] || { usage; exit 1; }

# Every tool call by default. This is cheaper than it sounds: a call that changed
# nothing exits at the `git status` check without a model call, so the cost tracks
# how often files actually change rather than how many tools run.
EVERY="${AUTO_COMMIT_EVERY:-1}"
# Conventional Commits: the subject is `type(scope): description`. Anything the
# model returns in another shape gets the fallback type rather than being thrown
# away, so the log stays parseable without losing a description that read the diff.
CONVENTIONAL_TYPES="${AUTO_COMMIT_TYPES:-feat|fix|chore|docs|refactor|test|perf|build|ci|style|revert}"
FALLBACK_TYPE="${AUTO_COMMIT_FALLBACK_TYPE:-chore}"
FALLBACK_MAX_FILES="${AUTO_COMMIT_FALLBACK_MAX_FILES:-5}"
BODY_MAX_LINES="${AUTO_COMMIT_BODY_MAX_LINES:-6}"
# The whole budget for the subject line. Past it the commit matters more than
# the wording: a checkpoint that arrives late is a checkpoint the next tool call
# has already raced, so it falls back to naming the files.
#
# Eight rather than five. A bare round trip to the endpoint measures under two
# seconds, but the request that matters carries up to 40 KB of diff and asks for
# 300 tokens back, and at five seconds dragonfly hit `curl (28) timed out ...
# with 88 bytes received` on every call it logged — the answer was arriving,
# always just too late, so every message there was a file listing. Three more
# seconds in the worst case buys back the wording.
TIMEOUT="${AUTO_COMMIT_TIMEOUT:-8}"
MAX_DIFF="${AUTO_COMMIT_MAX_DIFF:-40000}"
MODEL="${AUTO_COMMIT_MODEL:-deepseek/deepseek-v4-flash}"
API_URL="${AUTO_COMMIT_URL:-https://openrouter.ai/api/v1/chat/completions}"
API_KEY_VAR="${AUTO_COMMIT_API_KEY_VAR:-OPENROUTER_API_KEY}"
CRITIC_CMD="${AUTO_COMMIT_CMD:-}"
# A machine-local, one-line friendly name for this box, used in the trailer that
# marks a commit as automatic. Not in this repository: it differs per machine,
# which is the whole point of recording it.
DEVICE_FILE="${AUTO_COMMIT_DEVICE_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/workspace/device}"

note() { [ "$HOOK" = "1" ] || printf '%s\n' "$*"; }

# Some refusals must be heard even in hook mode, where `note` is silent. A
# conflict stops every future checkpoint until it is resolved, so staying quiet
# about it means work quietly stops being saved for the rest of the session.
speak() { printf '[auto-commit] %s\n' "$*" >&2; }

# The fourth argument is for the log only: the detail line has to stay short
# enough to read in a terminal, while the log can carry the whole of what a
# failing command said.
emit() {
  local status="$1" detail="$2" files="${3:-}" extra="${4:-}"
  # `clean` and `committed` are the working case and would otherwise write a
  # line per tool call; they are logged only when asked for. Everything else is
  # a run that wanted to commit and did not, which is the point of the file.
  case "$status" in
    clean|committed|dry-run)
      if [ "${AUTO_COMMIT_LOG_ALL:-0}" = "1" ]; then log_event "$status" "$detail" "$extra"; fi ;;
    *) log_event "$status" "$detail" "$extra" ;;
  esac
  if [ "$FORMAT" = "json" ]; then
    jq -n --arg status "$status" --arg detail "$detail" --arg files "$files" \
      '{status: $status, detail: $detail, files: ($files | split("\n") | map(select(length > 0)))}'
  else
    note "[$(printf '%s' "$status" | tr 'a-z' 'A-Z')] $detail"
    [ -z "$files" ] || note "$files"
  fi
}

# Hooks are launched in the harness's session directory, which can differ from
# the checkout a tool actually edited (Medulla commonly starts on `main`, then
# the agent works under `worktrees/<slug>`). Repository discovery has to follow
# the work rather than the long-lived harness process.
#
# It cannot do that from `cwd` alone. The session's `cwd` is fixed for the life
# of the process, and no tool on this harness reports a per-call working
# directory: a Bash `tool_input` carries only `command` and `description`, so an
# agent working under `worktrees/<slug>` does it by putting `cd` in the command
# string. Reading `cwd` therefore always names the session root, which is
# typically clean while the real work piles up unchecked in the worktree — the
# hook then reports "nothing to commit" forever and silently saves nothing.
#
# So take, in order of how precisely each names the edited checkout:
#   1. `file_path` — Edit, Write and NotebookEdit name the exact file touched
#   2. the last `cd` target in a Bash command, resolved against the session cwd
#   3. the event's `cwd`, which is right whenever the session sits in the
#      checkout being edited
event_target() {
  local fp dir cd_arg
  fp="$(printf '%s' "$EVENT" | jq -r '.tool_input.file_path // empty' 2>/dev/null || true)"
  if [ -n "$fp" ]; then
    dir="$(dirname -- "$fp")"
    [ -d "$dir" ] && { printf '%s' "$dir"; return 0; }
  fi

  # `cd foo && cargo test` and `cd -- "$HOME/x"; ls` both reduce to the target.
  # Only the last cd matters, and anything with a shell expansion left in it is
  # refused rather than guessed at — a wrong directory is worse than the cwd.
  cd_arg="$(printf '%s' "$EVENT" \
    | jq -r '.tool_input.command // empty' 2>/dev/null \
    | grep -oE '(^|[;&|]|&&)[[:space:]]*cd[[:space:]]+(--[[:space:]]+)?[^;&|]+' \
    | tail -1 \
    | sed -E 's/.*cd[[:space:]]+(--[[:space:]]+)?//; s/[[:space:]]+$//; s/^"//; s/"$//; s/^'"'"'//; s/'"'"'$//' \
    || true)"
  case "$cd_arg" in
    ''|-|*'$'*|*'`'*|*'*'*) ;;                       # unusable or unexpanded
    '~'|'~/'*) cd_arg="$HOME${cd_arg#\~}" ;;
  esac
  if [ -n "$cd_arg" ]; then
    case "$cd_arg" in
      /*) dir="$cd_arg" ;;
      *)  dir="${EVENT_CWD:-$PWD}/$cd_arg" ;;
    esac
    [ -d "$dir" ] && { printf '%s' "$dir"; return 0; }
  fi

  printf '%s' "${EVENT_CWD:-}"
}

EVENT=""
if [ "$HOOK" = "1" ]; then
  command -v jq >/dev/null 2>&1 || { log_event skipped "jq is not on PATH: PATH=$PATH"; exit 0; }
  EVENT="$(cat)"
  EVENT_CWD="$(printf '%s' "$EVENT" | jq -r '.cwd // empty' 2>/dev/null || true)"
  LOG_TOOL="$(printf '%s' "$EVENT" | jq -r '.tool_name // "-"' 2>/dev/null || echo '-')"
  TARGET="$(event_target)"
  if [ -n "$TARGET" ] && [ -d "$TARGET" ]; then
    cd -- "$TARGET"
  fi
fi

# ── Where are we ───────────────────────────────────────────────────
# Not a repository at all is not worth a line: the hook fires wherever the
# harness happens to be, and a directory outside any checkout is the expected
# case rather than a failure.
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
TOP="$(git rev-parse --show-toplevel)"
GIT_DIR="$(git rev-parse --absolute-git-dir)"
LOG_REPO="$TOP"
LOG_BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo detached)"

# ── Allowlisted repositories only ──────────────────────────────────
# Writing the message means sending the diff to a third-party model, so this
# runs in named repositories and nowhere else. The list is deliberately opt-in:
# a new checkout — a client's, a proprietary one, anything cloned in a hurry —
# is not covered until someone adds it here, which is the safe way round.
#
# Slugs match exactly, so `tinyhumansai/medulla` covers that repository and not
# `medulla-v1` or `medulla-backend`. Both owners are listed because `origin` is
# routinely the personal fork of an allowlisted upstream; only those two remotes
# are consulted, so an incidental third remote cannot admit a repository.
ALLOWED_REPOS="${AUTO_COMMIT_REPOS:-\
tinyhumansai/openhuman:tinyhumansai/opencompany:tinyhumansai/medulla:tinyhumansai/tinysweeper:\
tinyhumansai/tinyagents:tinyhumansai/tinybus:tinyhumansai/tinychannels:tinyhumansai/tinycortex:tinyhumansai/tinyflows:\
tinyhumansai/workspace:\
senamakel/openhuman:senamakel/opencompany:senamakel/medulla:senamakel/tinysweeper:\
senamakel/tinyagents:senamakel/tinybus:senamakel/tinychannels:senamakel/tinycortex:senamakel/tinyflows:\
senamakel/workspace}"
ALLOWED_REMOTES="${AUTO_COMMIT_REMOTES:-origin upstream}"

# git@host:owner/repo.git, https://host/owner/repo, ssh://git@host/owner/repo/
# and a bare owner/repo all reduce to the same lower-case owner/repo.
repo_slug() {
  local url="$1"
  url="${url%/}"
  url="${url%.git}"
  url="${url#*://}"      # scheme, if any
  url="${url#*@}"        # user@, if any
  url="${url#*:}"        # scp-style host separator
  # Keep the last two path components; a host prefix left by an https URL drops.
  local repo="${url##*/}"
  local rest="${url%/*}"
  local owner="${rest##*/}"
  [ "$rest" != "$url" ] || owner=""
  printf '%s' "$owner/$repo" | tr 'A-Z' 'a-z'
}

repo_allowed() {
  local slug url entry name
  for name in $ALLOWED_REMOTES; do
    url="$(git remote get-url "$name" 2>/dev/null || true)"
    [ -n "$url" ] || continue
    slug="$(repo_slug "$url")"
    for entry in $(printf '%s' "$ALLOWED_REPOS" | tr ':,' '  '); do
      [ "$slug" = "$(repo_slug "$entry")" ] && return 0
    done
  done
  return 1
}

if ! repo_allowed; then
  emit skipped "'$TOP' is not on the auto-commit allowlist (AUTO_COMMIT_REPOS)"
  exit 0
fi

# ── Tool-call counter ──────────────────────────────────────────────
# PostToolUse fires on every tool call. Only every Nth one does any work, so the
# other N-1 cost a counter increment and nothing else.
if [ "$HOOK" = "1" ]; then
  SESSION="$(printf '%s' "$EVENT" | jq -r '.session_id // "nosession"' 2>/dev/null || echo nosession)"
  STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/auto-commit"
  mkdir -p "$STATE_DIR"
  KEY="$(printf '%s:%s' "$SESSION" "$TOP" | shasum | cut -c1-32)"
  COUNT_FILE="$STATE_DIR/$KEY"
  COUNT="$(cat "$COUNT_FILE" 2>/dev/null || echo 0)"
  COUNT=$((COUNT + 1))
  if [ "$COUNT" -lt "$EVERY" ]; then
    printf '%s\n' "$COUNT" > "$COUNT_FILE"
    exit 0
  fi
  printf '0\n' > "$COUNT_FILE"
fi

# ── Guards ─────────────────────────────────────────────────────────
# An unmerged index means a conflict is sitting there half-resolved. The markers
# above do not catch all of these: a conflicting `git stash pop` leaves unmerged
# paths with no MERGE_HEAD at all, which is how a conflicted file nearly got
# checkpointed on one of these machines. Bail entirely rather than committing the
# other files, because a checkpoint taken mid-conflict is worse than none.
CONFLICTED="$(git diff --name-only --diff-filter=U 2>/dev/null || true)"
if [ -n "$CONFLICTED" ]; then
  speak "not committing: unresolved merge conflict in $(printf '%s' "$CONFLICTED" | tr '\n' ' ')"
  emit skipped "unresolved merge conflict"
  exit 0
fi

for marker in MERGE_HEAD REBASE_HEAD CHERRY_PICK_HEAD BISECT_LOG rebase-merge rebase-apply; do
  if [ -e "$GIT_DIR/$marker" ]; then
    speak "not committing: a $marker operation is in progress"
    emit skipped "a $marker operation is in progress"
    exit 0
  fi
done

# A detached HEAD is still refused: commits made there are unreachable from any
# branch and are lost to `gc` once HEAD moves, which is the opposite of a
# checkpoint. There is deliberately no protected-branch guard — the allowlisted
# repositories are worked on `main` directly, and refusing there meant the hook
# silently did nothing in exactly the repositories it was turned on for.
BRANCH="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
if [ -z "$BRANCH" ]; then
  emit skipped "detached HEAD"
  exit 0
fi

# ── What changed ───────────────────────────────────────────────────
# --porcelain omits ignored files, so build artifacts never appear here.
CHANGED=()
NESTED=()
while IFS= read -r -d '' entry; do
  status="${entry:0:2}"
  path="${entry:3}"
  source_path=""
  is_rename=0
  # With `-z`, porcelain v1 writes a rename/copy as the destination path in
  # this record followed by a second NUL-delimited source path.  Consume that
  # source record here; otherwise it is mistaken for a new status record and
  # its first three filename characters are discarded.
  case "$status" in
    *R*) is_rename=1; IFS= read -r -d '' source_path || true ;;
    *C*) IFS= read -r -d '' source_path || true ;;
  esac
  # `--untracked-files=all` still stops at the boundary of another repository:
  # an untracked nested checkout — a vendored dependency, a stray clone — is
  # reported as one entry with a trailing slash and git will not name the files
  # inside it. `atomic-commit` refuses a directory, correctly, and because that
  # refusal aborts the whole call the entire checkpoint was being lost: on
  # dragonfly one vendored clone stopped a worktree committing anything at all,
  # on every tool call, silently. Its contents belong to that other repository,
  # so drop the entry and commit everything around it.
  case "$path" in
    */) NESTED+=("$path"); continue ;;
  esac
  [ -n "$path" ] && CHANGED+=("$path")
  # `atomic-commit` first restores the index, so it needs the old side too in
  # order to re-stage the deletion that completes a rename.
  [ "$is_rename" = "1" ] && [ -n "$source_path" ] && CHANGED+=("$source_path")
# `--untracked-files=all` is load-bearing here.  Git's default `normal` mode
# collapses an untracked directory to (for example) `src/`; `atomic-commit`
# correctly refuses directory arguments, so a freshly initialized checkout
# could never receive its first checkpoint.
done < <(git status --porcelain=v1 -z --untracked-files=all 2>/dev/null || true)

if [ "${#NESTED[@]}" -gt 0 ]; then
  emit warned "not staging $(printf '%s ' "${NESTED[@]}")— a checkout inside this one, commit it in its own repository"
fi

if [ "${#CHANGED[@]}" -eq 0 ]; then
  emit clean "nothing to commit"
  exit 0
fi

# ── Never stage a credential ───────────────────────────────────────
# .gitignore is the usual defence, but this command stages files nobody
# reviewed first, so it keeps its own list rather than trusting the repo's.
SECRET_GLOBS=(
  '.env' '.env.*' '*.pem' '*.key' '*.p12' '*.pfx' '*.keystore' '*.jks'
  'id_rsa*' 'id_ed25519*' '*.ppk' '*.kdbx'
  '.npmrc' '.netrc' '*.token'
)
# Names that only *mention* a credential. `secrets.rs`, `credentials_test.go`
# and `secret-scan.md` are code and prose about credentials, not credentials,
# and refusing them meant whole modules were never checkpointed while their
# neighbours were. Source and prose extensions are let through on the name
# alone; the content scan below still reads them, and that is the check that
# actually finds a key. A `secrets.json`, `secrets.yaml` or extensionless
# `credentials` is not on this list and stays withheld.
SUSPICIOUS_GLOBS=('*credentials*' '*secret*')
SOURCE_EXTS='rs|ts|tsx|js|jsx|mjs|cjs|py|go|rb|java|kt|kts|swift|m|c|h|cc|cpp|hpp|cs|php|pl|lua|ex|exs|erl|hs|scala|dart|sh|bash|zsh|fish|md|mdx|rst|txt|sql|proto|graphql|snap'
# Built-in patterns are file names, not directory names: application source
# commonly lives below a `credentials/` domain without containing credentials.
# User-supplied skips still match the complete repository-relative path so a
# caller can deliberately withhold a particular directory or file.
EXTRA_SKIP_GLOBS=()
# Bash 3.2, which is what macOS ships, treats an empty array as unbound under
# `set -u`, so the caller's extra globs are appended rather than expanded beside
# the defaults.
if [ -n "${AUTO_COMMIT_SKIP:-}" ]; then
  # `|| [ -n "$glob" ]` is load-bearing: the input has no trailing newline, so
  # `read` returns non-zero on the final field and the loop body would never see
  # it. With one glob — the usual case — that meant AUTO_COMMIT_SKIP was read,
  # parsed, and silently discarded.
  while IFS= read -r glob || [ -n "$glob" ]; do
    [ -z "$glob" ] || EXTRA_SKIP_GLOBS+=("$glob")
  done < <(printf '%s' "$AUTO_COMMIT_SKIP" | tr ':' '\n')
fi

# A filename guard only catches secrets that live in obviously-named files. The
# commoner leak is a key pasted into ordinary source, so the content about to be
# committed is scanned too. Patterns are deliberately high-signal — shapes that
# are issued by a provider and effectively cannot occur by accident — because a
# false positive here silently withholds a file from every future commit.
SECRET_PATTERNS=(
  'aws-access-key|AKIA[0-9A-Z]{16}'
  'openai-or-anthropic-key|sk-(ant-)?[A-Za-z0-9_-]{24,}'
  'openrouter-key|sk-or-v1-[A-Za-z0-9]{16,}'
  'github-token|gh[pousr]_[A-Za-z0-9]{30,}'
  'slack-token|xox[baprs]-[A-Za-z0-9-]{10,}'
  'google-api-key|AIza[0-9A-Za-z_-]{35}'
  'stripe-key|[sr]k_live_[A-Za-z0-9]{16,}'
  'private-key-block|-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'json-web-token|eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}'
)
if [ -n "${AUTO_COMMIT_SECRET_PATTERNS:-}" ]; then
  # Same unterminated-final-field problem as AUTO_COMMIT_SKIP above.
  while IFS= read -r extra || [ -n "$extra" ]; do
    [ -z "$extra" ] || SECRET_PATTERNS+=("$extra")
  done < <(printf '%s' "$AUTO_COMMIT_SECRET_PATTERNS" | tr ':' '\n')
fi

# What this commit would actually add: new lines for a tracked file, the whole
# file for an untracked one. Only additions matter — content already in history
# is not this commit's doing.
added_content() {
  local f="$1"
  if git ls-files --error-unmatch -- "$f" >/dev/null 2>&1; then
    git diff HEAD -- "$f" 2>/dev/null | grep '^+' || true
  else
    head -c 1000000 "$f" 2>/dev/null || true
  fi
}

# A credential issued by a provider never spells out that it is fake, so a
# matched token that says so is a fixture, a docstring or a README — the
# commonest false positive by far, and one that silently withholds a file from
# every future checkpoint. Only the matched token is examined, not the line
# around it: a real key sitting on a line that happens to say "example" is
# still a real key.
# Words only. A digit run like `1234567890` looks like a placeholder to a human
# and is perfectly ordinary inside a real key, so numeric shapes are not on this
# list — the marker has to be something a random token effectively cannot spell.
PLACEHOLDER_MARKER='(x{4,}|example|sample|placeholder|redacted|dummy|fake|notreal|changeme|your[-_a-z]*key|testkey|test-key)'

# Prints the name of the first pattern the file's additions match, if any.
credential_in() {
  local f="$1" content entry name regex hits real
  content="$(added_content "$f")"
  [ -n "$content" ] || return 1
  for entry in "${SECRET_PATTERNS[@]}"; do
    name="${entry%%|*}"
    regex="${entry#*|}"
    # -e is required, not stylistic: the private-key pattern begins with "-----"
    # and grep would otherwise parse it as options and never match.
    hits="$(printf '%s' "$content" | LC_ALL=C grep -oaE -e "$regex" || true)"
    [ -n "$hits" ] || continue
    real="$(printf '%s\n' "$hits" | LC_ALL=C grep -viE "$PLACEHOLDER_MARKER" || true)"
    [ -n "$real" ] || continue
    printf '%s' "$name"
    return 0
  done
  return 1
}

# Conflict markers survive `git add`, at which point git stops calling the file
# unmerged and would happily commit it. Both the opening and closing markers are
# required so that prose *about* conflicts is not mistaken for one.
has_conflict_markers() {
  local f="$1" content
  content="$(added_content "$f")"
  [ -n "$content" ] || return 1
  printf '%s' "$content" | LC_ALL=C grep -qE '^\+?<<<<<<< ' \
    && printf '%s' "$content" | LC_ALL=C grep -qE '^\+?>>>>>>> '
}

STAGE=()
SKIPPED=()
LEAKS=()
CONFLICTS=()
for path in "${CHANGED[@]}"; do
  base="$(basename "$path")"
  secret=0
  for glob in "${SECRET_GLOBS[@]}"; do
    [ -n "$glob" ] || continue
    # shellcheck disable=SC2053
    if [[ "$base" == $glob ]]; then secret=1; break; fi
  done
  if [ "$secret" = "0" ]; then
    for glob in "${SUSPICIOUS_GLOBS[@]}"; do
      # shellcheck disable=SC2053
      if [[ "$base" == $glob ]]; then
        # Only withhold it if it is not source or prose.
        printf '%s' "$base" | LC_ALL=C grep -qiE "\.($SOURCE_EXTS)\$" || secret=1
        break
      fi
    done
  fi
  # Bash 3.2, which is what macOS ships as /bin/bash, treats `${arr[@]}` on an
  # empty array as an unbound variable under `set -u` and aborts the whole run.
  # The count has to be checked before the loop, not inside it.
  if [ "$secret" = "0" ] && [ "${#EXTRA_SKIP_GLOBS[@]}" -gt 0 ]; then
    for glob in "${EXTRA_SKIP_GLOBS[@]}"; do
      [ -n "$glob" ] || continue
      # shellcheck disable=SC2053
      if [[ "$base" == $glob || "$path" == $glob ]]; then secret=1; break; fi
    done
  fi
  if [ "$secret" = "1" ]; then
    SKIPPED+=("$path")
    continue
  fi
  if [ "${AUTO_COMMIT_SCAN_CONTENT:-1}" != "0" ] && has_conflict_markers "$path"; then
    CONFLICTS+=("$path")
    continue
  fi
  if [ "${AUTO_COMMIT_SCAN_CONTENT:-1}" != "0" ]; then
    # Keep the command substitution in its own conditional. Some hook runners
    # reparse compound `&& assignment` conditions poorly, despite Bash accepting
    # them when the helper is executed directly.
    if hit="$(credential_in "$path")"; then
      # Never echo the match itself — naming the file and the pattern is enough to
      # act on, and the value must not reach a log or a terminal scrollback.
      LEAKS+=("$path ($hit)")
      SKIPPED+=("$path")
      continue
    fi
  fi
  STAGE+=("$path")
done

# Markers mean a merge is still being resolved, so bail on the whole commit
# rather than checkpointing the untouched files around it — the same reasoning as
# the unmerged-index guard above.
if [ "${#CONFLICTS[@]}" -gt 0 ]; then
  speak "not committing: conflict markers still in $(printf '%s ' "${CONFLICTS[@]}")— resolve the merge first"
  emit skipped "conflict markers present"
  exit 0
fi

if [ "${#SKIPPED[@]}" -gt 0 ]; then
  emit warned "not staging $(printf '%s ' "${SKIPPED[@]}")— looks like a credential"
fi
if [ "${#STAGE[@]}" -eq 0 ]; then
  emit clean "nothing to commit after credential filtering"
  exit 0
fi

# ── Write the message ──────────────────────────────────────────────
STAT="$(git diff HEAD --stat -- "${STAGE[@]}" 2>/dev/null || true)"
DIFF="$(git diff HEAD -- "${STAGE[@]}" 2>/dev/null | head -c "$MAX_DIFF" || true)"
# An untracked file has no diff against HEAD; name it so the model still sees it.
UNTRACKED="$(git ls-files --others --exclude-standard -- "${STAGE[@]}" 2>/dev/null || true)"

# Without a model this still commits — a checkpoint with a dull message beats a
# lost checkpoint.
fallback_subject() {
  local n="${#STAGE[@]}" list rest
  list="$(printf '%s\n' "${STAGE[@]}" | head -"$FALLBACK_MAX_FILES" | paste -sd, - || true)"
  if [ "$n" -gt "$FALLBACK_MAX_FILES" ]; then
    rest=$((n - FALLBACK_MAX_FILES))
    list="$list +$rest more"
  fi
  printf '%s: files changed %s' "$FALLBACK_TYPE" "$list"
}

# Deliberately empty. The old fallback body said "Checkpoint of work in progress,
# touching <files>" on every message the model did not write, which restated the
# subject and the diff to no one's benefit: every commit this command makes is a
# checkpoint, and the trailer already says so. With nothing to summarise from,
# say nothing.
fallback_body() { printf ''; }

# Run a command with a wall-clock bound. curl bounds itself with --max-time, but
# an arbitrary AUTO_COMMIT_CMD does not, and macOS ships no `timeout`.
run_bounded() {
  local secs="$1"; shift
  local tmp pid ticks=0
  tmp="$(mktemp)"
  ( "$@" >"$tmp" 2>/dev/null ) &
  pid=$!
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$ticks" -ge "$((secs * 10))" ]; then
      kill -9 "$pid" 2>/dev/null || true
      wait "$pid" 2>/dev/null || true
      rm -f "$tmp"
      return 1
    fi
    sleep 0.1
    ticks=$((ticks + 1))
  done
  wait "$pid" 2>/dev/null || { rm -f "$tmp"; return 1; }
  cat "$tmp"
  rm -f "$tmp"
}

ask_model() {
  local prompt payload
  prompt="$(cat <<EOF
Write a Conventional Commits message for the change below.

Format — a subject line, one blank line, then a short prose description:

type(scope): short description

A sentence or two of plain prose saying what changed and why it was
done, written as continuous text rather than a list.

Rules for the subject:
- format: type(scope): description — the scope is optional
- type is one of: feat fix chore docs refactor test perf build ci style revert
- pick the type from what the change does: a new capability is feat, a bug fix is
  fix, documentation is docs, restructuring with no behaviour change is refactor,
  tests are test, and anything else routine is chore
- imperative mood, lower case description, no trailing period
- at most 72 characters

Rules for the description:
- plain prose, no bullets, no dashes, no numbered list
- at most $BODY_MAX_LINES lines and no more than three sentences
- say what changed and, where it is not obvious, why
- describe behaviour, not which files moved
- omit the description entirely for a trivial change

Read the diff in the right direction: a line starting with + is being added by
this change and a line starting with - is being removed. A file that gains lines
is being extended, not deleted. Describing a restored block as a removal is the
one mistake that makes the log actively misleading.

Output the message and nothing else — no code fences, no preamble.

Files:
$(printf '%s\n' "${STAGE[@]}")

Untracked among them:
${UNTRACKED:-none}

Stat:
$STAT

Diff:
$DIFF
EOF
)"
  if [ -n "$CRITIC_CMD" ]; then
    run_bounded "$TIMEOUT" "$CRITIC_CMD" -p "$prompt"
    return
  fi
  [ -n "${!API_KEY_VAR:-}" ] || return 1
  # Reasoning off, deliberately. This question does not need deliberation, and
  # leaving it on doubles the wait (3.3s vs 1.7s measured) while consuming the
  # token budget before any content is emitted — the reason an answer-sized
  # budget came back empty every time.
  payload="$(jq -n --arg model "$MODEL" --arg content "$prompt" \
    '{model: $model, temperature: 0, max_tokens: 300,
      reasoning: {enabled: false},
      messages: [{role: "user", content: $content}]}')"
  local raw content
  raw="$(curl -sS --fail-with-body --max-time "$TIMEOUT" --connect-timeout "$TIMEOUT" \
    -H "Authorization: Bearer ${!API_KEY_VAR}" \
    -H "Content-Type: application/json" \
    -d "$payload" "$API_URL" || true)"
  content="$(printf '%s' "$raw" | jq -r '.choices[0].message.content // ""' 2>/dev/null || true)"
  if [ -z "$content" ]; then
    # A request that fails outright leaves curl's message on stderr, but one that
    # returns 200 with no content — a provider error object, an empty choices
    # array, a response truncated at max_tokens — left nothing at all to look at,
    # and the fallback was indistinguishable from having no key. The body says
    # which of those it was; it carries no credential, only the reply.
    printf 'empty content from the endpoint; body was: %s\n' \
      "$(printf '%s' "$raw" | tr '\n' ' ' | cut -c1-400)" >&2
    return 1
  fi
  printf '%s\n' "$content"
}

# The model's own failures were being thrown away with its stderr, so a run that
# fell back to naming files looked identical to one that never had a key. Keep
# the error, log it if the answer turns out to be unusable.
MODEL_ERR="$(mktemp 2>/dev/null || printf '')"
[ -z "$MODEL_ERR" ] || trap 'rm -f "$MODEL_ERR"' EXIT
if [ -n "$MODEL_ERR" ]; then
  RESPONSE="$(ask_model 2>"$MODEL_ERR" || true)"
else
  RESPONSE="$(ask_model 2>/dev/null || true)"
fi
# Drop leading blank lines before anything reads the first one. A reply that
# opens with a newline — or with the blank line that follows a stripped code
# fence — put an empty string in `head -1`, and an empty subject is the signal
# for "the model gave nothing", so the entire message was thrown away and the
# commit fell back to listing files. The reply was there the whole time; on
# dragonfly this was the only remaining source of model-fallback entries, and it
# left no error behind to explain itself.
RESPONSE="$(printf '%s\n' "$RESPONSE" | sed '/[^[:space:]]/,$!d')"
SUBJECT="$(printf '%s\n' "$RESPONSE" | head -1 \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s/^["'"'"']//;s/["'"'"']$//')"
# Everything after the subject is the description. Blank lines and any stray code
# fence are dropped, and it is capped so a chatty model cannot bloat the log.
# The `|| true` matters: grep exits 1 when it filters everything away — which is
# exactly what happens when the model returns only a subject line — and pipefail
# would turn that into a silent exit before anything is committed.
BODY="$(printf '%s\n' "$RESPONSE" | tail -n +2 \
  | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' \
  | { grep -v '^```' || true; } | { grep -v '^$' || true; } \
  | head -"$BODY_MAX_LINES" || true)"

if [ -z "$SUBJECT" ]; then
  if [ -n "${!API_KEY_VAR:-}" ] || [ -n "$CRITIC_CMD" ]; then
    MODEL_REASON="no usable subject from $MODEL"
  else
    MODEL_REASON="no usable subject: $API_KEY_VAR is unset"
  fi
  log_event "model-fallback" "$MODEL_REASON" \
    "$([ -n "$MODEL_ERR" ] && head -c 2000 "$MODEL_ERR" 2>/dev/null || true)"
  SUBJECT="$(fallback_subject)"
  BODY="$(fallback_body)"
elif ! printf '%s' "$SUBJECT" \
  | grep -qE "^($CONVENTIONAL_TYPES)(\([^)]+\))?!?: .+"; then
  # The model answered, but not in Conventional Commits form. Keep what it said —
  # it read the diff — and give it the routine type rather than discarding it.
  SUBJECT="$FALLBACK_TYPE: $SUBJECT"
fi
SUBJECT="$(printf '%s' "$SUBJECT" | cut -c1-100)"
[ -n "$BODY" ] || BODY="$(fallback_body)"

# ── Which machine wrote this ───────────────────────────────────────
# Every checkpoint carries a trailer naming the machine that made it, which is
# also what distinguishes a checkpoint from a commit somebody wrote by hand:
# `atomic-commit` run directly adds nothing, so the trailer's presence *is* the
# "was this automatic?" answer.
#
# `Auto-committed-on` rather than "Signed on": these commits are GPG-signed for
# real (commit.gpgsign is on), and `Signed-off-by` already means a DCO sign-off.
# Borrowing either word would make the trailer ambiguous about the one thing it
# exists to state.
#
#   git log --format='%h %s %(trailers:key=Auto-committed-on,valueonly)'
#   git log --grep='^Auto-committed-on:' --   # every checkpoint
device_name() {
  local name=""
  if [ -n "${AUTO_COMMIT_DEVICE:-}" ]; then
    name="$AUTO_COMMIT_DEVICE"
  elif [ -r "$DEVICE_FILE" ]; then
    name="$(head -1 "$DEVICE_FILE" 2>/dev/null || true)"
  fi
  [ -n "$name" ] || name="$(hostname -s 2>/dev/null || hostname 2>/dev/null || true)"
  [ -n "$name" ] || name="unknown"
  # macOS reports `host.local`; the suffix says nothing and differs per network.
  name="${name%.local}"
  # A trailer is one line of `Key: value`, so anything that could introduce a
  # newline or break the parse is dropped rather than escaped.
  printf '%s' "$name" \
    | tr 'A-Z' 'a-z' \
    | LC_ALL=C tr -cd 'a-z0-9._-' \
    | cut -c1-64
}
DEVICE="$(device_name)"

# Subject, blank line, description, blank line, trailer — the shape git and every
# tool expect, with the trailer alone in the final paragraph so that
# `git interpret-trailers` and `%(trailers)` both see it.
if [ -n "$BODY" ]; then
  MESSAGE="$(printf '%s\n\n%s\n\n%s\n' "$SUBJECT" "$BODY" "Auto-committed-on: $DEVICE")"
else
  # No description at all rather than a paragraph restating the subject: the
  # trailer still needs its own blank line before it to parse as a trailer.
  MESSAGE="$(printf '%s\n\n%s\n' "$SUBJECT" "Auto-committed-on: $DEVICE")"
fi

FILE_LIST="$(printf '%s\n' "${STAGE[@]}")"

if [ "$DRY" = "1" ]; then
  emit dry-run "$SUBJECT" "$(printf '%s\n---\n%s' "$BODY" "$FILE_LIST")"
  exit 0
fi

# ── Commit ─────────────────────────────────────────────────────────
# Hand the vetted paths to atomic-commit rather than staging here: it unstages
# everything else first without discarding it, so a credential this command
# refused to touch cannot ride along on an index someone else left dirty. Paths
# came from `git status` and are relative to the top level, so run it there —
# atomic-commit resolves its arguments against the current prefix.
ATOMIC="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/atomic-commit"
if [ ! -x "$ATOMIC" ]; then
  emit skipped "atomic-commit not found beside this command"
  exit 0
fi
if ! OUTPUT="$(cd "$TOP" && "$ATOMIC" --allow-whitespace "$MESSAGE" -- "${STAGE[@]}" 2>&1)"; then
  # A rejected path or nothing actually staged. Never fatal: the working tree is
  # untouched and the next tick tries again. Only the first couple of lines reach
  # the terminal, so the whole of what atomic-commit said goes to the log along
  # with the paths it was given — between them they say which file it choked on,
  # which the summary alone never did.
  emit skipped "atomic-commit refused: $(printf '%s' "$OUTPUT" | head -2 | tr '\n' ' ')" "" \
    "$(printf '%s\n' "$OUTPUT" | head -40; printf 'paths:\n'; printf '  %s\n' "${STAGE[@]}")"
  exit 0
fi

emit committed "$SUBJECT" "$FILE_LIST"

# A withheld credential must not pass silently. In hook mode `note` prints
# nothing, so the file would simply never be committed and no one would know;
# exit 2 puts the reason in front of the harness instead. The commit above still
# stands — the safe files are saved, only the offending one is held back.
if [ "${#LEAKS[@]}" -gt 0 ]; then
  {
    printf 'auto-commit withheld %s file(s): a credential-shaped string was found in content about to be committed.\n' "${#LEAKS[@]}"
    printf '  %s\n' "${LEAKS[@]}"
    printf 'Remove the secret from the file (move it to an env var or an ignored file) before it can be committed.\n'
    printf 'If it is a fixture and not a real credential, set AUTO_COMMIT_SCAN_CONTENT=0 for this repo or narrow the pattern.\n'
  } >&2
  exit 2
fi
exit 0
