#!/usr/bin/env bash
# workflow-update — update direct submodules and record their gitlinks.
set -euo pipefail

usage() {
  cat <<'EOF'
workflow-update [--no-commit]

Update each first-level submodule to upstream/main, falling back to origin/main.
Each submodule is forced onto local main at the selected remote commit, discarding
divergent local main commits and tracked changes. Nested submodules are then
re-initialized recursively (shallow, borrowing local objects) so they match the
commit their parent just moved to. The superproject is not fetched, merged,
switched, or reset.

Only refs/heads/main is fetched from the selected remote, which keeps the fetch
proportional to the branch rather than to the whole repository. Fetches run with
terminal and SSH prompts disabled, so a missing credential fails instead of
hanging forever waiting on input that no agent will supply.

Options:
  --no-commit  stage changed submodule pointers without committing
  -h, --help   show this help
EOF
}

if [ -t 1 ]; then
  _R=$'\033[0;31m' _G=$'\033[0;32m' _Y=$'\033[0;33m' _B=$'\033[1m' _0=$'\033[0m'
else
  _R="" _G="" _Y="" _B="" _0=""
fi
pass()  { printf '%s[PASS]%s %s\n' "$_G" "$_0" "$*"; }
fail()  { printf '%s[FAIL]%s %s\n' "$_R" "$_0" "$*" >&2; }
warn()  { printf '%s[WARN]%s %s\n' "$_Y" "$_0" "$*" >&2; }
info()  { printf '%s[INFO]%s %s\n' "$_B" "$_0" "$*"; }

# A fetch that cannot authenticate must fail, not block on a prompt that nothing
# is there to answer. BatchMode covers SSH remotes, GIT_TERMINAL_PROMPT covers
# HTTPS ones, and ConnectTimeout bounds an unreachable host.
export GIT_TERMINAL_PROMPT=0
export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=15}"

SUBMODULE_INIT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)/submodule-init"

COMMIT=1
if [ "$#" -gt 1 ]; then
  fail "unknown argument: $2"
  exit 1
fi
while [ "$#" -gt 0 ]; do
  case "$1" in
    --no-commit)
      [ "$COMMIT" = "1" ] || { fail "unknown argument: $1"; exit 1; }
      COMMIT=0
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      fail "unknown argument: $1"
      exit 1
      ;;
  esac
  shift
done

TOPLEVEL="$(git rev-parse --show-toplevel 2>/dev/null)" \
  || { fail "not inside a git repository"; exit 1; }
cd "$TOPLEVEL"
TOPLEVEL_PHYSICAL="$(pwd -P)"
[ -f .gitmodules ] || { fail "no .gitmodules here — not a workflow superproject"; exit 1; }
SUPER_GIT_DIR="$(git rev-parse --absolute-git-dir)"
SUPER_GIT_DIR_PHYSICAL="$(cd "$SUPER_GIT_DIR" && pwd -P)"

canonical_local_url() {
  local url="$1" base="$2" path parent

  case "$url" in
    file://localhost/*)
      path="/${url#file://localhost/}"
      ;;
    file:///*)
      path="${url#file://}"
      ;;
    file://*)
      return 1
      ;;
    *://*|*:*)
      return 1
      ;;
    /*)
      path="$url"
      ;;
    *)
      path="$base/$url"
      ;;
  esac

  if [ -d "$path" ]; then
    cd "$path" 2>/dev/null && pwd -P
    return
  fi
  parent="$(dirname "$path")"
  [ -e "$path" ] \
    && cd "$parent" 2>/dev/null \
    && printf '%s/%s\n' "$(pwd -P)" "$(basename "$path")"
}

urls_match() {
  local registered="$1" candidate="$2" dir="$3"
  local registered_local candidate_local

  [ "$registered" = "$candidate" ] && return 0
  registered_local="$(canonical_local_url "$registered" "$TOPLEVEL_PHYSICAL" || true)"
  candidate_local="$(canonical_local_url "$candidate" "$dir" || true)"
  [ -n "$registered_local" ] \
    && [ "$registered_local" = "$candidate_local" ]
}

verify_submodule_ownership() {
  local dir="$1" name="$2" recorded="$3"
  local actual_git_dir expected_git_dir reported_superproject resolved_superproject
  local registered_url candidate candidate_url matching_remote contains_recorded

  if [ -f "$dir/.git" ]; then
    actual_git_dir="$(git -C "$dir" rev-parse --absolute-git-dir 2>/dev/null || true)"
    actual_git_dir="$(
      [ -n "$actual_git_dir" ] \
        && cd "$actual_git_dir" 2>/dev/null \
        && pwd -P \
        || true
    )"
    expected_git_dir="$(
      cd "$SUPER_GIT_DIR_PHYSICAL/modules/$name" 2>/dev/null \
        && pwd -P \
        || true
    )"
    if [ -z "$actual_git_dir" ] || [ "$actual_git_dir" != "$expected_git_dir" ]; then
      fail "$dir: unrelated Git repository obstructs submodule path"
      return 1
    fi
    return 0
  fi

  reported_superproject="$(
    git -C "$dir" rev-parse --show-superproject-working-tree 2>/dev/null || true
  )"
  resolved_superproject="$(
    [ -n "$reported_superproject" ] \
      && cd "$reported_superproject" 2>/dev/null \
      && pwd -P \
      || true
  )"
  registered_url="$(git config --get "submodule.$name.url" 2>/dev/null || true)"
  contains_recorded=""
  if git -C "$dir" cat-file -e "$recorded^{commit}" 2>/dev/null; then
    contains_recorded=1
  fi
  matching_remote=""
  for candidate in upstream origin; do
    candidate_url="$(git -C "$dir" remote get-url "$candidate" 2>/dev/null || true)"
    if [ -n "$candidate_url" ] \
      && urls_match "$registered_url" "$candidate_url" "$dir"; then
      matching_remote="$candidate"
      break
    fi
  done
  if [ "$resolved_superproject" != "$TOPLEVEL_PHYSICAL" ] \
    || [ -z "$registered_url" ] \
    || { [ -z "$contains_recorded" ] && [ -z "$matching_remote" ]; }; then
    fail "$dir: unrelated Git repository obstructs submodule path"
    return 1
  fi
}

select_main() {
  local dir="$1" candidate ref commit
  for candidate in upstream origin; do
    if ! git -C "$dir" remote get-url "$candidate" >/dev/null 2>&1; then
      warn "$dir: $candidate is not configured"
      continue
    fi
    # Only main is needed to move the pointer. Fetching every ref of a
    # multi-gigabyte submodule is the single slowest step of this command.
    if ! git -C "$dir" fetch --prune "$candidate" main; then
      warn "$dir: failed to fetch $candidate/main"
      continue
    fi
    ref="refs/remotes/$candidate/main"
    if ! commit="$(git -C "$dir" rev-parse --verify "$ref^{commit}" 2>/dev/null)"; then
      warn "$dir: $candidate/main does not resolve to a commit"
      continue
    fi
    SELECTED_REMOTE="$candidate"
    SELECTED_COMMIT="$commit"
    return 0
  done
  fail "$dir: neither upstream/main nor origin/main is available"
  return 1
}

# The first untracked path that a checkout of <target> would have to overwrite,
# either directly or because one of its parent directories is a file there.
#
# This is a set intersection, done in one pass over two listings. Asking Git per
# path instead — one `cat-file` for the path and one more for each ancestor —
# means tens of thousands of subprocesses per submodule, because `ls-files
# --others` includes ignored files and these checkouts carry large build trees.
# On workflow-medulla that alone ran for over ten minutes at full CPU.
obstructing_untracked() {
  local dir="$1" target="$2"
  awk -v RS='\0' '
    NR == FNR { tracked[$0] = 1; next }
    {
      if ($0 in tracked) { print; exit }
      n = split($0, part, "/")
      acc = ""
      for (i = 1; i < n; i++) {
        acc = (i == 1 ? part[1] : acc "/" part[i])
        if (acc in tracked) { print; exit }
      }
    }
  ' <(git -C "$dir" ls-tree -r -z --name-only "$target") \
    <(git -C "$dir" ls-files --others -z)
}

force_local_main() {
  local dir="$1" commit="$2" current target path
  for target in HEAD "$commit"; do
    path="$(obstructing_untracked "$dir" "$target")"
    if [ -n "$path" ]; then
      fail "$dir: untracked path obstructs synchronization: $path"
      return 1
    fi
  done

  git -C "$dir" reset --hard HEAD
  current="$(git -C "$dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ "$current" != "main" ]; then
    git -C "$dir" branch -f main "$commit"
    git -C "$dir" checkout --quiet main
  fi
  git -C "$dir" reset --hard "$commit"
}

CHANGED_PATHS=()
while IFS= read -r -d '' SM_CONFIG_ENTRY; do
  SM_KEY="${SM_CONFIG_ENTRY%%$'\n'*}"
  SM_PATH="${SM_CONFIG_ENTRY#*$'\n'}"
  [ -n "$SM_PATH" ] || continue
  SM_NAME="${SM_KEY#submodule.}"
  SM_NAME="${SM_NAME%.path}"
  RECORDED="$(git rev-parse "HEAD:$SM_PATH")"
  if [ ! -d "$SM_PATH/.git" ] && [ ! -f "$SM_PATH/.git" ]; then
    git submodule sync --recursive -- "$SM_PATH"
    "$SUBMODULE_INIT" --quiet .
  fi
  [ -d "$SM_PATH/.git" ] || [ -f "$SM_PATH/.git" ] \
    || { fail "$SM_PATH: submodule was not initialized"; exit 1; }
  verify_submodule_ownership "$SM_PATH" "$SM_NAME" "$RECORDED"
  git submodule sync -- "$SM_PATH"

  select_main "$SM_PATH"
  force_local_main "$SM_PATH" "$SELECTED_COMMIT"
  info "$SM_PATH: selected $SELECTED_REMOTE/$SELECTED_COMMIT"

  # The reset above moved this submodule's tree, and with it every nested
  # gitlink it records. Without this pass the nested submodules stay at the
  # commits the *previous* parent commit named, which is the difference between
  # a workflow checkout that builds and one that silently uses stale vendored
  # sources. Shallow and object-borrowing, so it costs seconds.
  if [ -f "$SM_PATH/.gitmodules" ]; then
    git -C "$SM_PATH" submodule sync --recursive >/dev/null
    if ! NESTED_OUTPUT="$("$SUBMODULE_INIT" --quiet "$SM_PATH" 2>&1)"; then
      fail "$SM_PATH: nested submodule initialization failed"
      printf '%s\n' "$NESTED_OUTPUT" >&2
      exit 1
    fi
    info "$SM_PATH: nested submodules initialized recursively"
  fi

  if [ "$RECORDED" = "$SELECTED_COMMIT" ]; then
    info "$SM_PATH: superproject pointer unchanged"
  else
    git add -- "$SM_PATH"
    pass "$SM_PATH: superproject pointer changed ($RECORDED -> $SELECTED_COMMIT)"
    CHANGED_PATHS+=("$SM_PATH")
  fi
done < <(
  git config -z -f .gitmodules --get-regexp '^submodule\..*\.path$' 2>/dev/null \
)

# ── 2. Commit the moved pointers ───────────────────────────────────
if [ "${#CHANGED_PATHS[@]}" -eq 0 ]; then
  pass "all submodule pointers already up to date"
elif [ "$COMMIT" = "1" ]; then
  git commit -m "Update submodule pointers" -- "${CHANGED_PATHS[@]}"
  pass "committed submodule pointer update"
else
  info "pointer changes staged; commit skipped (--no-commit)"
fi
