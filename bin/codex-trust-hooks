#!/usr/bin/env bash
# codex-trust-hooks — enable the shared Codex hooks on this machine.
#
# Usage: codex-trust-hooks [--list] [--dry-run]
#
# Codex records every hook it discovers in ~/.codex/config.toml as a state entry
# keyed by "<path>:<event>:<group>:<index>", carrying a trusted_hash of the hook
# and an `enabled` flag that defaults to false. Hooks therefore do nothing until
# something flips that flag — normally an interactive prompt, which never
# appears on a headless box and blocks `codex exec` when it tries.
#
# codex/hooks.json is shared through this repo, so every machine computes the
# same trusted_hash; only the enable flag is machine-local, which is why it
# cannot simply be synced. Run this once per box, and again whenever
# codex/hooks.json changes, because editing it invalidates the recorded hash.
#
# Two sources of shared hooks are enabled, and the second is the one that is
# easy to miss:
#
#   ~/.codex/hooks.json           this repo's own file, linked in by install.sh
#   /<session-flags>/config.toml  the pseudo-path Codex keys a `-c hooks=…`
#                                 command-line override under
#
# The second is how Medulla delivers the hooks declared in medulla/config.toml —
# it injects them per spawn rather than writing them to disk, so they arrive as
# a config override and land in the state store *disabled*, exactly like any
# other hook Codex has not been told to trust. Medulla deliberately does not
# pass --dangerously-bypass-hook-trust (that flag is invocation-wide and would
# also authorize whatever .codex/hooks.json the checked-out repository happens to
# ship), and it reports the requirement instead of bypassing it. Until this
# script flips those entries, *nothing* Medulla declares runs on Codex — not the
# shared hooks and not Medulla's own session reporting hooks — and it fails
# silently, with nothing on stderr and a zero exit.
#
# Only the two paths above are touched; a hook the workspace or another tool
# registered is left alone. The trust model is preserved either way: an entry
# only exists once Codex has recorded a hash for that exact hook, so this
# enables what has already been seen and never pre-authorizes hook text that
# has yet to appear.
#
# What this cannot do, measured against Codex 0.146: `enabled = true` only
# counts while the recorded trusted_hash still matches the hook Codex is being
# handed. Change a hook — edit hooks.json, add a `[[hooks]]` entry to Medulla's
# config, rebuild Medulla so a built-in's binary path moves — and the whole
# event group rehashes. Codex then reports the group as needing review and
# keeps the *old* hash: registration does not refresh it, only an explicit
# trust does. So a changed hook set costs one interactive acceptance — start
# the harness and press `t` on the Hooks screen — after which this script is
# again what keeps the entries enabled on every later launch. It is not a way
# around that acceptance, and deliberately so: forging a trusted_hash here
# would be the same blanket authorization --dangerously-bypass-hook-trust
# hands out, just written to disk.
set -euo pipefail

LIST=0
DRY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list)    LIST=1; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '[FAIL] unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done

CONFIG="$HOME/.codex/config.toml"
if [ ! -f "$CONFIG" ]; then
  printf '[skip] no %s — Codex has not run on this machine\n' "$CONFIG"
  exit 0
fi

[ "$DRY" = "1" ] || [ "$LIST" = "1" ] || cp -a "$CONFIG" "$CONFIG.bak.$(date +%Y%m%d%H%M%S)"

python3 - "$CONFIG" "$LIST" "$DRY" <<'PY'
import re, sys
config, list_only, dry = sys.argv[1], sys.argv[2] == "1", sys.argv[3] == "1"
text = open(config).read()

# Each state entry is a table header followed by its keys, up to the next table.
pattern = re.compile(
    r'(\[hooks\.state\."(?P<key>[^"]*)"\]\n)(?P<body>(?:(?!\[)[^\n]*\n)*)')

# The two sources this script speaks for, matched against the "<path>" half of a
# "<path>:<event>:<group>:<index>" state key. Anything else — a hook the
# checked-out workspace declares, a path some other tool registered — is left
# exactly as Codex recorded it.
SHARED = re.compile(
    r'^(?:'
    r'.*/\.codex/hooks\.json'        # this repo's file, linked in by install.sh
    r'|/<session-flags>/config\.toml'  # Medulla's per-spawn `-c hooks=` override
    r'):[^:]+:\d+:\d+$')

changed, found = 0, 0
def fix(m):
    global changed, found
    if not SHARED.match(m.group("key")):
        return m.group(0)
    found += 1
    body = m.group("body")
    state = "enabled" if re.search(r'^enabled\s*=\s*true', body, re.M) else "disabled"
    print(f"  {state:8} {m.group('key')}")
    if list_only or state == "enabled":
        return m.group(0)
    new_body, n = re.subn(r'^enabled\s*=\s*false', 'enabled = true', body, flags=re.M)
    if n == 0:
        new_body = body.rstrip("\n") + "\nenabled = true\n"
        n = 1
    changed += n
    return m.group(1) + new_body

updated = pattern.sub(fix, text)

if found == 0:
    print("  no hook state entries — run codex once so it registers them")
elif list_only:
    pass
elif changed == 0:
    print("  nothing to change")
elif dry:
    print(f"  would enable {changed} hook(s)")
else:
    open(config, "w").write(updated)
    print(f"  enabled {changed} hook(s)")
PY
