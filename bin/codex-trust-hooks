#!/usr/bin/env bash
# codex-trust-hooks — enable the shared Codex hooks on this machine.
#
# Usage: codex-trust-hooks [--list] [--dry-run]
#
# Codex records every hook it discovers in ~/.codex/config.toml as a state entry
# keyed by "<path>:<event>:<group>:<index>", carrying a trusted_hash of the hook
# and an `enabled` flag that defaults to false. Hooks therefore do nothing until
# something flips that flag — normally an interactive prompt, which never
# appears on a headless box and blocks `codex exec` when it tries.
#
# codex/hooks.json is shared through this repo, so every machine computes the
# same trusted_hash; only the enable flag is machine-local, which is why it
# cannot simply be synced. Run this once per box, and again whenever
# codex/hooks.json changes, because editing it invalidates the recorded hash.
#
# This covers `~/.codex/hooks.json` — the file this repo links in — and nothing
# else. A hook the checked-out workspace or another tool registered is left
# alone, and so is Medulla's, which is no longer this script's job:
#
# Medulla injects the hooks declared in medulla/config.toml per spawn, as a
# `-c hooks=…` override that Codex keys under the pseudo-path
# `/<session-flags>/config.toml`. Those entries land disabled like any other, so
# for a while nothing Medulla declared ran on Codex at all — not the shared
# hooks and not Medulla's own session reporting — silently, with nothing on
# stderr and a zero exit. Medulla now enables its own entries as it builds the
# launch (`harness_hooks::codex::trust`), scoped to the events that spawn is
# installing, so this script would only be duplicating it. Run `medulla codex`
# once; if its hooks are still inert, that is a Medulla bug, not a missing run
# of this.
#
# The trust model is preserved either way: an entry only exists once Codex has
# recorded a hash for that exact hook, so this enables what has already been
# seen and never pre-authorizes hook text that has yet to appear. Editing
# hooks.json rehashes it, which is why the flag has to be set again afterwards.
set -euo pipefail

LIST=0
DRY=0
while [ $# -gt 0 ]; do
  case "$1" in
    --list)    LIST=1; shift ;;
    --dry-run) DRY=1; shift ;;
    -h|--help) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf '[FAIL] unknown argument: %s\n' "$1" >&2; exit 1 ;;
  esac
done

CONFIG="$HOME/.codex/config.toml"
if [ ! -f "$CONFIG" ]; then
  printf '[skip] no %s — Codex has not run on this machine\n' "$CONFIG"
  exit 0
fi

[ "$DRY" = "1" ] || [ "$LIST" = "1" ] || cp -a "$CONFIG" "$CONFIG.bak.$(date +%Y%m%d%H%M%S)"

python3 - "$CONFIG" "$LIST" "$DRY" <<'PY'
import re, sys
config, list_only, dry = sys.argv[1], sys.argv[2] == "1", sys.argv[3] == "1"
text = open(config).read()

# Each state entry is a table header followed by its keys, up to the next table.
pattern = re.compile(
    r'(\[hooks\.state\."(?P<key>[^"]*)"\]\n)(?P<body>(?:(?!\[)[^\n]*\n)*)')

# The one source this script speaks for, matched against the "<path>" half of a
# "<path>:<event>:<group>:<index>" state key. Anything else — a hook the
# checked-out workspace declares, Medulla's own injection, a path some other tool
# registered — is left exactly as Codex recorded it.
SHARED = re.compile(r'^.*/\.codex/hooks\.json:[^:]+:\d+:\d+$')

changed, found = 0, 0
def fix(m):
    global changed, found
    if not SHARED.match(m.group("key")):
        return m.group(0)
    found += 1
    body = m.group("body")
    state = "enabled" if re.search(r'^enabled\s*=\s*true', body, re.M) else "disabled"
    print(f"  {state:8} {m.group('key')}")
    if list_only or state == "enabled":
        return m.group(0)
    new_body, n = re.subn(r'^enabled\s*=\s*false', 'enabled = true', body, flags=re.M)
    if n == 0:
        new_body = body.rstrip("\n") + "\nenabled = true\n"
        n = 1
    changed += n
    return m.group(1) + new_body

updated = pattern.sub(fix, text)

if found == 0:
    print("  no hook state entries — run codex once so it registers them")
elif list_only:
    pass
elif changed == 0:
    print("  nothing to change")
elif dry:
    print(f"  would enable {changed} hook(s)")
else:
    open(config, "w").write(updated)
    print(f"  enabled {changed} hook(s)")
PY
