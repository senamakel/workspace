#!/usr/bin/env bash
# gh-fork-clone — fork a GitHub repo, clone your fork locally with upstream
# remote configured.
#
# Usage: gh-fork-clone <owner/repo> [flags...]
#
#   gh-fork-clone atuinsh/atuin
#   gh-fork-clone sharkdp/bat --target-dir /tmp/bat-dev
#   gh-fork-clone QwenLM/qwen-code --open-source   # ~/work/open-source/qwenlm--qwen-code
#   gh-fork-clone hyprwm/Hyprland --clone=false    # fork only
#
# Default target: ~/work/others/<repo-name>.
# Idempotent — safe to re-run on existing forks and clones.
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BOLD='\033[1m'
NC='\033[0m'

usage() {
  cat <<'EOF'
Usage: gh-fork-clone <owner/repo> [flags...]

  Fork a GitHub repository, then clone your fork locally with upstream
  remote pointing at the canonical repo.

Flags:
  --target-dir <dir>   clone into <dir> (default: ~/work/others/<repo>)
  --open-source        use open-source convention ~/work/open-source/<owner>--<repo>
  --clone=false        fork only, skip the clone (passed through to gh)

Other flags after the repo are forwarded to `gh repo fork`.

Examples:
  gh-fork-clone atuinsh/atuin
  gh-fork-clone sharkdp/bat --target-dir /tmp/bat-dev
  gh-fork-clone hyprwm/Hyprland --open-source
  gh-fork-clone QwenLM/qwen-code --clone=false
EOF
  exit 0
}

main() {
  if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    usage
  fi

  if [ $# -eq 0 ]; then
    echo -e "${RED}Error:${NC} no repository specified." >&2
    echo "Usage: gh-fork-clone <owner/repo>" >&2
    exit 1
  fi

  local repo="$1"
  shift

  # Validate repo format
  if [[ ! "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    echo -e "${RED}Error:${NC} '$repo' doesn't look like owner/repo." >&2
    exit 1
  fi

  # Check that gh is available
  if ! command -v gh &>/dev/null; then
    echo -e "${RED}Error:${NC} gh (GitHub CLI) is not installed." >&2
    exit 1
  fi

  # Check gh auth
  if ! gh auth status &>/dev/null; then
    echo -e "${RED}Error:${NC} gh is not authenticated. Run 'gh auth login' first." >&2
    exit 1
  fi

  local repo_name="${repo#*/}"
  local repo_owner="${repo%/*}"
  local target_dir=""
  local open_source_mode=0
  local fork_flags=()

  # Parse our flags; unknown flags pass through to gh repo fork
  while [ $# -gt 0 ]; do
    case "$1" in
      --target-dir)
        [ $# -ge 2 ] || { echo -e "${RED}Error:${NC} --target-dir requires a value." >&2; exit 1; }
        target_dir="$2"
        shift 2
        ;;
      --open-source)
        open_source_mode=1
        shift
        ;;
      --clone=false)
        fork_flags+=("$1")
        shift
        ;;
      --clone)  # --clone with value
        fork_flags+=("$1" "$2")
        shift 2
        ;;
      *)
        fork_flags+=("$1")
        shift
        ;;
    esac
  done

  # Determine target directory
  if [ -z "$target_dir" ]; then
    if [ "$open_source_mode" -eq 1 ]; then
      # Lowercase the owner for consistent filesystem naming
      local owner_lower
      owner_lower="$(echo "$repo_owner" | tr '[:upper:]' '[:lower:]')"
      target_dir="$HOME/work/open-source/${owner_lower}--${repo_name}"
    else
      target_dir="$HOME/work/others/$repo_name"
    fi
  fi

  # -----------------------------------------------------------------------
  # Step 1 — Fork (idempotent: gh repo fork --remote is safe to re-run)
  # -----------------------------------------------------------------------
  echo -e "${BOLD}→ Forking ${repo}...${NC}"
  if gh repo fork "$repo" --clone=false "${fork_flags[@]}" 2>&1; then
    echo -e "  ${GREEN}✓${NC} fork ready"
  else
    # Fork may already exist — that's fine, continue
    echo -e "  ${YELLOW}!${NC} fork may already exist, continuing..."
  fi

  # -----------------------------------------------------------------------
  # Step 2 — Clone (skip if target directory already exists)
  # -----------------------------------------------------------------------
  if [ -d "$target_dir" ]; then
    echo -e "  ${YELLOW}!${NC} $target_dir already exists, skipping clone."
    echo -e "  ${GREEN}✓${NC} cd $target_dir"
  else
    mkdir -p "$(dirname "$target_dir")"

    # Determine our fork URL
    local gh_user
    gh_user="$(gh api user --jq '.login')"
    local fork_url="git@github.com:${gh_user}/${repo_name}.git"

    echo -e "${BOLD}→ Cloning ${fork_url} into ${target_dir}...${NC}"
    git clone "$fork_url" "$target_dir"
    echo -e "  ${GREEN}✓${NC} cloned"

    # Add upstream remote pointing at the original repo
    (
      cd "$target_dir"
      local upstream_url="git@github.com:${repo}.git"
      if ! git remote get-url upstream &>/dev/null; then
        git remote add upstream "$upstream_url"
        echo -e "  ${GREEN}✓${NC} upstream remote → ${upstream_url}"
      fi
    )
  fi

  # -----------------------------------------------------------------------
  # Summary
  # -----------------------------------------------------------------------
  echo
  echo -e "${BOLD}${GREEN}Done.${NC}"
  echo -e "  repo:   ${BOLD}${repo}${NC}"
  echo -e "  fork:   ${BOLD}$(gh api user --jq '.login')/${repo_name}${NC}"
  echo -e "  local:  ${BOLD}${target_dir}${NC}"

  if [ -d "$target_dir/.git" ]; then
    echo
    echo "Remotes:"
    (cd "$target_dir" && git remote -v) | sed 's/^/  /'
  fi
}

main "$@"
