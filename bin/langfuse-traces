#!/usr/bin/env bash
# langfuse-traces — agent-friendly list of Langfuse traces.
#
# Usage: langfuse-traces [--env <alias>] [--project <alias>] [--name <exact>]
#                        [--session <id>] [--user <id>] [--tag <tag>]
#                        [--since <24h|7d|ISO>] [--until <ISO>]
#                        [--environment <deployment-env>] [--limit <N>] [--json]
#
#   langfuse-traces --env staging --project medulla --since 24h
#   langfuse-traces --env staging --name agent.turn --limit 5
#   langfuse-traces --env staging --session 35cdf638-... --json
#
# `--name` filters server-side on an exact trace name; `--project` matches the
# preset's regex against trace names after fetching, so it can span the several
# names one product emits (`agent.turn`, `flow.run:*`, …). Both may be combined
# with `--tag`, `--user` and the time window.
set -euo pipefail
# shellcheck source=bin/langfuse-lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/langfuse-lib.sh"

usage() { sed -n '2,19p' "$0" | sed 's/^# \{0,1\}//'; }

FORMAT="text"; ENV_ALIAS=""; PROJECT=""; NAME=""; SESSION=""; USER_ID=""; TAG=""
SINCE=""; UNTIL=""; DEPLOY_ENV=""; LIMIT=20; BASE=""; PK=""; SK=""

while [ $# -gt 0 ]; do
  case "$1" in
    --json)        FORMAT="json"; shift ;;
    --env)         [ $# -ge 2 ] || { usage; lf_fail "--env needs a value"; }
                   ENV_ALIAS="$2"; shift 2 ;;
    --project)     [ $# -ge 2 ] || { usage; lf_fail "--project needs a value"; }
                   PROJECT="$2"; shift 2 ;;
    --name)        [ $# -ge 2 ] || { usage; lf_fail "--name needs a value"; }
                   NAME="$2"; shift 2 ;;
    --session)     [ $# -ge 2 ] || { usage; lf_fail "--session needs a value"; }
                   SESSION="$2"; shift 2 ;;
    --user)        [ $# -ge 2 ] || { usage; lf_fail "--user needs a value"; }
                   USER_ID="$2"; shift 2 ;;
    --tag)         [ $# -ge 2 ] || { usage; lf_fail "--tag needs a value"; }
                   TAG="$2"; shift 2 ;;
    --since)       [ $# -ge 2 ] || { usage; lf_fail "--since needs a value"; }
                   SINCE="$2"; shift 2 ;;
    --until)       [ $# -ge 2 ] || { usage; lf_fail "--until needs a value"; }
                   UNTIL="$2"; shift 2 ;;
    --environment) [ $# -ge 2 ] || { usage; lf_fail "--environment needs a value"; }
                   DEPLOY_ENV="$2"; shift 2 ;;
    --limit)       [ $# -ge 2 ] || { usage; lf_fail "--limit needs a value"; }
                   LIMIT="$2"; shift 2 ;;
    --base-url)    [ $# -ge 2 ] || { usage; lf_fail "--base-url needs a value"; }
                   BASE="$2"; shift 2 ;;
    --public-key)  [ $# -ge 2 ] || { usage; lf_fail "--public-key needs a value"; }
                   PK="$2"; shift 2 ;;
    --secret-key)  [ $# -ge 2 ] || { usage; lf_fail "--secret-key needs a value"; }
                   SK="$2"; shift 2 ;;
    -h|--help)     usage; exit 0 ;;
    *)             usage; lf_fail "unknown argument: $1" ;;
  esac
done
case "$LIMIT" in ''|*[!0-9]*|0) lf_fail "--limit must be a positive integer" ;; esac

lf_require curl jq
lf_config "$ENV_ALIAS" "$BASE" "$PK" "$SK"

Q=""
[ -z "$NAME" ]       || Q="$Q&name=$(lf_urlencode "$NAME")"
[ -z "$SESSION" ]    || Q="$Q&sessionId=$(lf_urlencode "$SESSION")"
[ -z "$USER_ID" ]    || Q="$Q&userId=$(lf_urlencode "$USER_ID")"
[ -z "$TAG" ]        || Q="$Q&tags=$(lf_urlencode "$TAG")"
[ -z "$SINCE" ]      || Q="$Q&fromTimestamp=$(lf_urlencode "$(lf_iso "$SINCE")")"
[ -z "$UNTIL" ]      || Q="$Q&toTimestamp=$(lf_urlencode "$(lf_iso "$UNTIL")")"
[ -z "$DEPLOY_ENV" ] || Q="$Q&environment=$(lf_urlencode "$DEPLOY_ENV")"

PATTERN="$(lf_project_pattern "$PROJECT")"
# With a client-side name filter, over-fetch so --limit still returns N matches.
FETCH="$LIMIT"; [ -z "$PATTERN" ] || FETCH=$(( LIMIT * 10 ))
RAW="$(lf_api_paged "/traces${Q:+?${Q#&}}" "$FETCH")"

TRACES="$(jq -c --arg pat "$PATTERN" --argjson limit "$LIMIT" "
  $LF_JQ_PRELUDE
  [ .[] | select(\$pat == \"\" or ((.name // \"\") | test(\$pat; \"i\"))) ]
  | .[0:\$limit]
  | map({
      id, name, timestamp, sessionId, userId,
      environment: (.environment // null),
      tags: (.tags // []),
      latency: (.latency // null),
      totalCost: (.totalCost // null),
      observations: ((.observations // []) | length),
      input: ((.input | lftext) | lfline | lfclip(160)),
      output: ((.output | lftext) | lfline | lfclip(160))
    })" <<<"$RAW")"

REPORT="$(jq -n --arg env "$LF_ENV_R" --arg host "$LF_BASE" \
               --arg project "${PROJECT:-(all)}" --arg name "${NAME:-(any)}" \
               --arg since "${SINCE:-(any)}" --argjson traces "$TRACES" '
  {env: $env, host: $host, project: $project, name: $name, since: $since,
   count: ($traces | length), traces: $traces}')"

if [ "$FORMAT" = "json" ]; then jq . <<<"$REPORT"; exit 0; fi

jq -r '
  "Langfuse traces — env \(.env)  project \(.project)  name \(.name)  since \(.since)  (\(.count) found)",
  (.traces[] |
    "",
    "\(.id)  \(.name // "(unnamed)")  \(.timestamp)",
    "  session: \(.sessionId // "-")  user: \(.userId // "-")  environment: \(.environment // "-")",
    "  observations: \(.observations)  latency: \(.latency // "-")  cost: \(.totalCost // "-")\(if (.tags | length) > 0 then "  tags: \(.tags | join(", "))" else "" end)",
    (if .input  != "" then "  in:  \(.input)"  else empty end),
    (if .output != "" then "  out: \(.output)" else empty end)
  ),
  "",
  "Detail: langfuse-trace <trace-id> --env \(.env)"
' <<<"$REPORT"
