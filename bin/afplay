#!/usr/bin/env bash
# afplay — portable, safe notification sound shim.
#
# On macOS, delegate to the native player. Elsewhere, emit a terminal bell over
# the current PTY so SSH/mosh carries the notification back to the client.
# Sound-file arguments are deliberately ignored by the fallback and never
# evaluated.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: afplay [native-afplay arguments...]

macOS: delegates arguments to /usr/bin/afplay.
Other systems: emits one terminal bell and exits successfully.

Environment:
  AFPLAY_NATIVE  native player path (default: /usr/bin/afplay)
  AFPLAY_OUTPUT  auto (default), stdout, tty, or silent
EOF
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
esac

NATIVE_PLAYER="${AFPLAY_NATIVE:-/usr/bin/afplay}"
if [ -x "$NATIVE_PLAYER" ] && ! [ "$NATIVE_PLAYER" -ef "$0" ]; then
  exec "$NATIVE_PLAYER" "$@"
fi

# `[ -w /dev/tty ]` is not the question. The node is world-writable, so the test
# passes even for a process with no controlling terminal — and the open then
# fails with ENXIO, which under `set -e` makes a notification hook exit 1 and
# report an error for a sound nobody needed. Only an attempted open can tell,
# and its failure is not an error here: no terminal simply means no bell.
bell_to_tty() {
  { printf '\a' >/dev/tty; } 2>/dev/null
}

OUTPUT_MODE="${AFPLAY_OUTPUT:-auto}"
case "$OUTPUT_MODE" in
  silent)
    exit 0
    ;;
  stdout)
    printf '\a'
    exit 0
    ;;
  tty)
    bell_to_tty || true
    exit 0
    ;;
  auto)
    if ! bell_to_tty; then
      [ -t 1 ] && printf '\a' || true
    fi
    exit 0
    ;;
  *)
    printf 'afplay: invalid AFPLAY_OUTPUT: %s\n' "$OUTPUT_MODE" >&2
    exit 2
    ;;
esac
