#!/usr/bin/env bash
# venicecodex — Codex CLI, but driven by a model on Venice.
#
# Usage: venicecodex [codex args...]
#
#   venicecodex                          interactive session on Qwen 3.6 Plus
#   venicecodex exec "explain this repo"  non-interactive, same as `codex exec`
#   venicecodex --dangerously-bypass-approvals-and-sandbox   flags pass through
#
# The Venice sibling of `deepcodex`: it points Codex at Venice's own API for
# this process only and exec's `codex`, so your normal `codex` (signed in to
# OpenAI) is untouched. Nothing is written to ~/.codex/config.toml — every
# setting is a `-c` override, which is also why `codex login` still owns your
# real account.
#
# Requires VENICE_INFERENCE_KEY (set in ~/.zshenv, where the LLM router reads
# it too). Overridable:
#
#   VENICECODEX_MODELS   the models the session can pick from, as
#                        `slug:context_tokens` entries separated by spaces
#                        (default: "qwen-3-6-plus:300000 gemma-4-uncensored:256000 olafangensan-glm-4.7-flash-heretic:200000 aion-labs-aion-3-0:128000 venice-uncensored-1-2:128000
#                        olafangensan-glm-4.7-flash-heretic:200000
#                        aion-labs-aion-3-0:128000 venice-uncensored-1-2:128000").
#                        Every entry lands in the catalog, so `/model` inside
#                        Codex lists all of them and switches between them
#                        mid-session; the first is the one a session starts on.
#   VENICECODEX_MODEL    start on this entry instead of the first. A slug not
#                        in VENICECODEX_MODELS is added with the context window
#                        of VENICECODEX_CONTEXT_WINDOW.
#   VENICECODEX_CONTEXT_WINDOW  context for a VENICECODEX_MODEL that is not in
#                        the list, and for any entry written without a `:ctx`
#                        (default 300000; blank for 1000000).
#   VENICECODEX_EFFORT   reasoning effort (default: medium)
#   VENICECODEX_BASE_URL provider endpoint (default: Venice direct)
#   VENICECODEX_CATALOG  path of the generated model catalog
#
# The context is what Codex is told the window is, so every budget it computes
# is drawn against it: Qwen 3.6 Plus advertises 1M, and the same accuracy caveat
# `deepcodex` applies to DeepSeek's 1M applies here, so it is declared at 300k.
#
# ── Which model ───────────────────────────────────────────────────
# `qwen-3-6-plus` starts by default: Venice hosts it unfiltered, it has a 1M
# window, and in the probe that decided this (2026-09-11) it read a file and
# created another through real function calls on the first try. The rest of the
# default list, each probed on 2026-09-12 with one `function` tool on the
# Responses endpoint:
#
#   gemma-4-uncensored (256k)                  calls tools; the uncensored-
#                                              branded alternative.
#   olafangensan-glm-4.7-flash-heretic (200k)  a clean function_call on the
#                                              first try, nothing else.
#   aion-labs-aion-3-0 (128k)                  emits the function_call, but
#                                              also echoes it as an
#                                              `<uncensored_tool_call>` text
#                                              block in the same turn. Codex
#                                              acts on the call and shows the
#                                              echo as prose; harmless, noisy.
#   venice-uncensored-1-2 (128k)               does NOT call tools: it writes
#                                              the arguments as a fenced JSON
#                                              block instead of emitting a
#                                              function call, in both probes.
#                                              Codex is nothing but function
#                                              calls, so a session on it does
#                                              no work. Listed so `/model` can
#                                              reach it for chat; never the
#                                              default.
#
# The slugs are the API's, not the chat URL's: venice.ai/chat?model=gemma4-uncensored
# is `gemma-4-uncensored` on the wire. `GET /models?type=text` is the list.
# `VENICECODEX_MODEL=<slug> venicecodex` starts on any of them.
#
# ── What is switched off, and why ─────────────────────────────────
# Venice's Responses endpoint validates strictly and answers anything it does
# not model with a 400 — or, for the tool list, a bare 500 `Inference processing
# failed` that Codex shows as `Reconnecting... 1/5` and gives up on. Each
# override below removes one thing it choked on; each was found by putting a
# logging proxy in front of the endpoint and reading the request Codex sent.
#
#   reasoning.summary = null   Codex's `none` summary is serialised as null;
#                              Venice wants auto|concise|detailed. Hence
#                              model_reasoning_summary=auto, in the catalog too.
#   type = "web_search" tool   web_search=disabled drops it.
#   type = "namespace" tools   Codex groups collaboration and MCP tools into
#                              namespace entries. Venice knows `function` only,
#                              so multi-agent, apps and plugins are off and the
#                              MCP server list is emptied for this process.
#   type = "additional_tools"  an input item from the experimental tool set and
#                              responses-lite; both are cleared in the catalog.
#
# So a venicecodex session has no MCP servers, no subagents and no web search.
# That is the price of the endpoint, not a choice; lift any of them by passing
# your own `-c` after the wrapper's — later overrides win.
#
# ── Venice's own system prompt ────────────────────────────────────
# Venice prepends ~1,000 tokens of its own system prompt to every request. On
# chat completions the `:include_venice_system_prompt=false` model suffix (or
# `venice_parameters`) strips it; on the Responses API — the only wire Codex
# speaks since 0.146 — neither does anything (measured 2026-09-11: 1573 input
# tokens for "hi" with or without the suffix). So every turn carries it. It is
# a cost, not a breakage; Codex's own instructions still arrive after it.
#
# ── Why a generated model catalog ──────────────────────────────────
# Codex refuses to run a model it has no metadata for, and `model_catalog_json`
# is where that comes from. As in `deepcodex`, the entry is derived from the
# catalog the installed Codex already cached for itself, so the embedded
# instructions always match the Codex on this machine.
#
# The same three fields are turned off, for the same reason: Venice's API takes
# `function` tools and nothing else, and each of these is sent as a different
# tool type that fails the whole request.
#
#   apply_patch_tool_type  freeform apply_patch is sent as a `custom` tool
#   tool_mode              `code_mode_only` is likewise a `custom` tool
#   supports_search_tool   sent as a `tool_search` tool
set -euo pipefail

fail() { printf 'venicecodex: %s\n' "$*" >&2; }

command -v codex >/dev/null 2>&1 || { fail "'codex' CLI not found on PATH."; exit 1; }
command -v jq    >/dev/null 2>&1 || { fail "'jq' is required to build the model catalog."; exit 1; }

if [ -z "${VENICE_INFERENCE_KEY:-}" ]; then
  fail "VENICE_INFERENCE_KEY is not set."
  fail "  Add it to your ~/.zshenv: export VENICE_INFERENCE_KEY=VENICE_INFERENCE_KEY_..."
  exit 1
fi

PROVIDER_ID="venice"
PROVIDER_NAME="Venice"
BASE_URL="${VENICECODEX_BASE_URL:-https://api.venice.ai/api/v1}"
KEY_VAR="VENICE_INFERENCE_KEY"
EFFORT="${VENICECODEX_EFFORT:-medium}"

# The `-` (not `:-`) is deliberate: blanking the variable means "no cap", while
# leaving it unset means the default.
CONTEXT="${VENICECODEX_CONTEXT_WINDOW-300000}"
[ -n "$CONTEXT" ] || CONTEXT=1000000
case "$CONTEXT" in
  ''|*[!0-9]*) fail "VENICECODEX_CONTEXT_WINDOW must be a number of tokens: $CONTEXT"; exit 1 ;;
esac

# The model list, as parallel arrays of slug and declared context. The start
# model is VENICECODEX_MODEL if set, else the first entry; a start model not in
# the list is prepended so it is in the catalog too.
read -r -a ENTRIES <<< "${VENICECODEX_MODELS:-qwen-3-6-plus:300000 gemma-4-uncensored:256000 olafangensan-glm-4.7-flash-heretic:200000 aion-labs-aion-3-0:128000 venice-uncensored-1-2:128000}"
[ ${#ENTRIES[@]} -gt 0 ] || { fail "VENICECODEX_MODELS is empty."; exit 1; }
SLUGS=()
CTXS=()
for entry in "${ENTRIES[@]}"; do
  slug="${entry%%:*}"
  ctx="${entry#"$slug"}"
  ctx="${ctx#:}"
  [ -n "$ctx" ] || ctx="$CONTEXT"
  case "$ctx" in
    *[!0-9]*) fail "context must be a number of tokens in VENICECODEX_MODELS entry: $entry"; exit 1 ;;
  esac
  SLUGS+=("$slug")
  CTXS+=("$ctx")
done
MODEL="${VENICECODEX_MODEL:-${SLUGS[0]}}"
listed=0
for slug in "${SLUGS[@]}"; do
  [ "$slug" = "$MODEL" ] && listed=1
done
if [ "$listed" -eq 0 ]; then
  SLUGS=("$MODEL" "${SLUGS[@]}")
  CTXS=("$CONTEXT" "${CTXS[@]}")
fi

# ── The model catalog ──────────────────────────────────────────────
CACHE_SRC="${CODEX_HOME:-$HOME/.codex}/models_cache.json"
CATALOG="${VENICECODEX_CATALOG:-${XDG_CACHE_HOME:-$HOME/.cache}/venicecodex/models.json}"

if [ ! -f "$CACHE_SRC" ]; then
  fail "no Codex model metadata at $CACHE_SRC."
  fail "  Run 'codex' once (it caches the catalog on start), then try again."
  exit 1
fi

mkdir -p "$(dirname "$CATALOG")"

# Rebuilt every run rather than cached: it is one jq pass over a small file, and
# it means a Codex upgrade never leaves a stale system prompt behind. One entry
# per listed model, all cloned from the same template; the start model gets
# priority 1 so it is the one Codex opens on and lists first.
MODELS_JSON="$(
  for i in "${!SLUGS[@]}"; do
    printf '{"slug":"%s","ctx":%s}\n' "${SLUGS[$i]}" "${CTXS[$i]}"
  done | jq -s .
)"
if ! jq --arg start "$MODEL" --argjson models "$MODELS_JSON" --arg effort "$EFFORT" '
      # Highest-priority real model as the template. The auto-review entry is a
      # special-purpose profile, not a general coding one, so it is excluded.
      [ (.models // .)[] | select((.slug // "") | test("auto-review") | not) ]
      | sort_by(.priority) | .[0]
      | if . == null then error("no usable template model in the Codex catalog") else . end
      | . as $template
      | [ $models | to_entries[] | .key as $i | .value as $m | $template
      | .slug = $m.slug
      | .display_name = "Venice \($m.slug)"
      | .description = "\($m.slug) on Venice, driven through Codex by venicecodex."
      | .context_window = $m.ctx
      | .max_context_window = $m.ctx
      | .effective_context_window_percent = 95
      | .default_reasoning_level = $effort
      | .priority = (if $m.slug == $start then 1 else $i + 2 end)
      | .upgrade = null
      | .availability_nux = null
      # Everything Venice rejects — see the header.
      | .apply_patch_tool_type = null
      | .tool_mode = null
      | .supports_search_tool = false
      | del(.web_search_tool_type)
      | .experimental_supported_tools = []
      | .use_responses_lite = false
      | .default_reasoning_summary = "auto"
      | del(.multi_agent_version)
      ]
      | {models: .}
    ' "$CACHE_SRC" > "$CATALOG.tmp" 2>/dev/null; then
  rm -f "$CATALOG.tmp"
  fail "could not build a model catalog from $CACHE_SRC."
  exit 1
fi
mv "$CATALOG.tmp" "$CATALOG"

# ── Hand off ───────────────────────────────────────────────────────
# `wire_api = "responses"`: Codex dropped the chat-completions wire in 0.146,
# and Venice serves the Responses API at the same base as chat completions.
exec codex \
  -c model="$MODEL" \
  -c model_provider="$PROVIDER_ID" \
  -c model_providers."$PROVIDER_ID".name="$PROVIDER_NAME" \
  -c model_providers."$PROVIDER_ID".base_url="$BASE_URL" \
  -c model_providers."$PROVIDER_ID".env_key="$KEY_VAR" \
  -c model_providers."$PROVIDER_ID".wire_api="responses" \
  -c model_catalog_json="$CATALOG" \
  -c model_reasoning_effort="$EFFORT" \
  -c model_reasoning_summary="auto" \
  -c preferred_auth_method="apikey" \
  -c web_search="disabled" \
  -c features.multi_agent=false \
  -c features.apps=false \
  -c features.plugins=false \
  -c features.remote_plugin=false \
  -c "mcp_servers={}" \
  "$@"
