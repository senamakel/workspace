#!/usr/bin/env bash
# check-open-source-state — validate the shared open-source contribution state.
#
# Usage: check-open-source-state [state-directory]
set -euo pipefail

fail() {
  printf '[FAIL] %s\n' "$*" >&2
  exit 1
}

require() {
  command -v "$1" >/dev/null 2>&1 \
    || fail "missing required tool: $1"
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
STATE_ROOT="${1:-$ROOT/open-source}"
CATALOG="$STATE_ROOT/repositories.json"
ISSUES_DIR="$STATE_ROOT/issues"

require jq
[ -f "$CATALOG" ] || fail "missing repository catalog: $CATALOG"
[ -d "$ISSUES_DIR" ] || fail "missing issue state directory: $ISSUES_DIR"

jq -e '
  .schema_version == 1 and
  (.updated_at == null or (.updated_at | type) == "string") and
  ((.repositories | type) == "array") and
  all(.repositories[];
    ((.repo | type) == "string" and
      (.repo | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"))) and
    ((.url | type) == "string" and
      .url == ("https://github.com/" + .repo)) and
    ((.default_branch | type) == "string" and
      (.default_branch | length) > 0) and
    ((.languages | type) == "array" and
      all(.languages[]; type == "string")) and
    ((.license | type) == "string" and
      (.license | length) > 0) and
    (.stars | (type == "number" and . >= 0 and floor == .)) and
    (.open_issues | (type == "number" and . >= 0 and floor == .)) and
    ((.status | type) == "string" and
      (.status | IN("active", "watch", "paused", "retired", "rejected"))) and
    ((.discovered_at | type) == "string" and
      (.last_researched_at | type) == "string") and
    ((.selection_score | type) == "number" and
      .selection_score >= 0 and .selection_score <= 100) and
    ((.signals | type) == "object") and
    ((.rationale | type) == "string" and
      (.rationale | length) > 0) and
    ((.evidence_urls | type) == "array" and
      (.evidence_urls | length) > 0 and
      all(.evidence_urls[]; type == "string"))
  ) and
  ([.repositories[].repo] | length == (unique | length))
' "$CATALOG" >/dev/null \
  || fail "invalid repository catalog: $CATALOG"

issue_count=0
issue_ids=()
while IFS= read -r -d '' issue_file; do
  issue_count=$((issue_count + 1))
  filename="$(basename "$issue_file")"
  [[ "$filename" =~ ^[A-Za-z0-9_.-]+--[A-Za-z0-9_.-]+--[0-9]+\.json$ ]] \
    || fail "invalid issue filename: $filename"

  jq -e '
    .schema_version == 1 and
    ((.repo | type) == "string" and
      (.repo | test("^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"))) and
    (.issue_number | (type == "number" and . > 0 and floor == .)) and
    .id == (.repo + "#" + (.issue_number | tostring)) and
    .url == ("https://github.com/" + .repo + "/issues/" +
      (.issue_number | tostring)) and
    ((.title | type) == "string" and (.title | length) > 0) and
    ((.created_at | type) == "string" and
      (.updated_at | type) == "string" and
      (.triaged_at | type) == "string") and
    ((.status | type) == "string" and
      (.status | IN(
        "queued", "claimed", "in_progress", "pr_open", "waiting",
        "green", "merged", "closed", "blocked", "rejected", "stale"
      ))) and
    ((.priority_score | type) == "number" and
      .priority_score >= 0 and .priority_score <= 100) and
    (.estimated_minutes |
      (type == "number" and . > 0 and floor == .)) and
    ((.verification_plan | type) == "string" and
      (.verification_plan | length) > 0) and
    ((.signals | type) == "object") and
    (.signals.has_active_pr == false) and
    (.signals.assigned == false) and
    (.signals.recent_claim == false) and
    ((.evidence_urls | type) == "array" and
      (.evidence_urls | length) > 0 and
      all(.evidence_urls[]; type == "string")) and
    ((.claim | type) == "object") and
    ((.pull_request == null) or (.pull_request | type) == "object") and
    ((.history | type) == "array" and
      (.history | length) > 0 and
      all(.history[];
        ((.at | type) == "string") and
        ((.status | type) == "string") and
        ((.note | type) == "string" and (.note | length) > 0)
      )) and
    (.history[-1].status == .status) and
    (if (.status | IN("claimed", "in_progress", "pr_open", "waiting",
      "green", "merged")) then
      ((.claim.worker | type) == "string" and
        (.claim.worker | length) > 0) and
      ((.claim.claimed_at | type) == "string") and
      ((.claim.branch | type) == "string" and
        (.claim.branch | length) > 0) and
      ((.claim.worktree | type) == "string" and
        (.claim.worktree | length) > 0)
    else true end) and
    (if (.status | IN("pr_open", "waiting", "green", "merged")) then
      ((.pull_request.url | type) == "string" and
        (.pull_request.url | startswith("https://github.com/"))) and
      (.pull_request.number |
        (type == "number" and . > 0 and floor == .)) and
      ((.pull_request.head_sha | type) == "string" and
        (.pull_request.head_sha | test("^[0-9a-f]{40}$"))) and
      ((.pull_request.opened_at | type) == "string")
    else true end)
  ' "$issue_file" >/dev/null \
    || fail "invalid issue record: $issue_file"

  issue_ids+=("$(jq -r '.id' "$issue_file")")
done < <(find "$ISSUES_DIR" -maxdepth 1 -type f -name '*.json' -print0)

if [ "${#issue_ids[@]}" -gt 0 ]; then
  unique_count="$(printf '%s\n' "${issue_ids[@]}" | sort -u | wc -l | tr -d ' ')"
  [ "$unique_count" -eq "${#issue_ids[@]}" ] \
    || fail "duplicate issue id in $ISSUES_DIR"
fi

repo_count="$(jq '.repositories | length' "$CATALOG")"
printf '[PASS] open-source state is valid (%s repositories, %s issues)\n' \
  "$repo_count" "$issue_count"
