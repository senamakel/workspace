#!/usr/bin/env bash
# ladder-up — make sure this box's llm-ladder-router container is up and answering.
#
# Usage: ladder-up [--check] [--pull] [--recreate] [--quiet]
#
# Idempotent, and safe to run from cron every few minutes: a healthy container
# is left strictly alone. It starts a stopped one, recreates one whose run
# arguments no longer match what this script would build, and always finishes by
# asking the router for a real answer over its own API — a container that is
# "running" but wedged is not up.
#
# It also keeps this box's router config in step with the one in this
# repository. `ladder/config.toml` is the fleet's config: it names every
# credential as an environment variable and holds no secret, which is what lets
# one file be the config on every box. The keys stay in ~/.zshenv, per box.
#
# A config is only installed once the image about to run it has *accepted* it,
# because the two move together and the config is usually the one that moves
# first. Installing a config the running binary cannot parse is not a degraded
# router, it is no router: the container exits at startup, `--restart always`
# restarts it into the same failure, and the box crash-loops until someone
# looks. That is not hypothetical — it is what a config carrying `aliases`
# did to this box against an image that predated them.
#
# --check reports what it would do and changes nothing.
# --pull refreshes the image first; the cron watchdog deliberately does not, so
# a routine health check never swaps the binary underneath a running agent.
# --recreate forces a rebuild even when the spec matches, which is how a newly
# exported key reaches the container: docker copies the environment in at create
# time and a running container never sees a later one.
set -euo pipefail

NAME="ladder"
IMAGE="ghcr.io/senamakel/llm-ladder-router:latest"
CONFIG="$HOME/.config/ladder/config.toml"
# The fleet's copy, in this repository, beside this script.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
REPO_CONFIG="$REPO_ROOT/ladder/config.toml"
PORT="6969"
# Where the probe talks to it, and the address a shell on this box uses.
BIND="127.0.0.1"
# Every address the router listens on. Loopback for this box's own processes,
# and the docker0 gateway because that is what `host.docker.internal` resolves
# to inside a container — every box runs its own router, and a container has to
# be able to reach the one on its own host.
#
# Not 0.0.0.0. Every box is on the tailnet, and this router holds the keys to
# every provider account; the two addresses below are the ones that are
# actually needed, and neither of them is routable from another machine.
#
# The symptom this fixes is silent, which is why it is worth spelling out.
# CortexDB's capture is WAL-durable BEFORE it embeds, so with the router
# unreachable it answered 200 to every write, reported `degraded: false` on
# /v1/admin/ready, and filed events it never embedded. The only visible trace
# was `vectors` sitting still while `wal_events` climbed — 1333 events against
# 523 vectors on this box before anyone looked.
BINDS=("127.0.0.1")
# docker0 exists only where docker does, and the laptop's Docker Desktop maps
# `host.docker.internal` to the host itself without needing this.
if command -v docker >/dev/null 2>&1 && [ "$(uname -s)" = "Linux" ]; then
  DOCKER0="$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)"
  [ -n "${DOCKER0:-}" ] && BINDS+=("$DOCKER0")
fi
# The router is a proxy: it holds order books and session pins, not model state.
# The cap exists so that a box under memory pressure kills the workload rather
# than the thing every agent on it dispatches through — dragonfly lost this
# container to a cgroup OOM kill on 2026-08-20 while a `lean` process was taking
# 4GB a time.
MEMORY="512m"
# The credentials the container needs, in the order the router reports them.
# Absent ones are passed as empty and the router skips that provider with a
# warning rather than failing to start.
KEYS=(LADDER_API_KEY SURPLUS_API_KEY OPENROUTER_API_KEY MISTRAL_API_KEY VENICE_INFERENCE_KEY)

CHECK=0
PULL=0
RECREATE=0
QUIET=0

log() {
  [ "$QUIET" -eq 1 ] && return 0
  printf '%s\n' "$*"
}

# Always printed, even under --quiet, because cron mail is the only place a
# failing watchdog gets to speak.
fail() {
  printf 'ladder-up: %s\n' "$*" >&2
}

usage() {
  sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --pull) PULL=1 ;;
    --recreate) RECREATE=1 ;;
    --quiet|-q) QUIET=1 ;;
    -h|--help) usage; exit 0 ;;
    *) fail "unknown argument: $1"; usage >&2; exit 2 ;;
  esac
  shift
done

# cron gives us almost no PATH and no shell profile, so find docker where the
# three platforms actually put it before giving up.
if ! command -v docker >/dev/null 2>&1; then
  for candidate in /usr/local/bin/docker /opt/homebrew/bin/docker /usr/bin/docker; do
    [ -x "$candidate" ] && PATH="$(dirname "$candidate"):$PATH" && break
  done
fi
command -v docker >/dev/null 2>&1 || { fail "docker not found on PATH"; exit 1; }
docker info >/dev/null 2>&1 || { fail "docker daemon is not responding"; exit 1; }

[ -f "$CONFIG" ] || [ -f "$REPO_CONFIG" ] || {
  fail "no router config at $CONFIG and none in this repository"
  exit 1
}

# Read the keys out of ~/.zshenv. They live there rather than in this repository
# because the repository is public; cron does not source it, so pull them in
# explicitly. zsh does the reading, not a grep: robot1 defines LADDER_API_KEY as
# a command substitution that reads the router's own config, and a parser that
# copies the line's text hands the container the literal `$(sed ...)` and every
# caller a key that 401s.
ENVFILE="$HOME/.zshenv"
if [ -f "$ENVFILE" ] && command -v zsh >/dev/null 2>&1; then
  while IFS='=' read -r key value; do
    [ -n "$key" ] || continue
    [ -n "${!key:-}" ] && continue
    [ -n "$value" ] && export "$key=$value"
  done < <(zsh -fc 'source "$1" >/dev/null 2>&1; for k in '"${KEYS[*]}"'; do print -r -- "$k=${(P)k}"; done' zsh "$ENVFILE" 2>/dev/null || true)
fi

missing=()
for key in "${KEYS[@]}"; do
  [ -n "${!key:-}" ] || missing+=("$key")
done
[ ${#missing[@]} -gt 0 ] && log "[warn] unset, provider will be skipped: ${missing[*]}"
[ -n "${LADDER_API_KEY:-}" ] || { fail "LADDER_API_KEY is unset; callers could not authenticate"; exit 1; }

# The image is published for amd64 only, so an arm64 daemon has to be told to
# run it under emulation. Fine for a router: the work is network I/O.
#
# The daemon is asked rather than `uname`, because on Apple Silicon the two
# disagree and `uname` is the one that is wrong here. mac-mini's login shell
# runs under Rosetta and reports `Darwin/x86_64`, so a `uname`-based guess left
# the platform unset while Docker itself was natively arm64 and pulled for
# arm64 — `no matching manifest for linux/arm64/v8`, on a box the guess existed
# to cover. What decides the pull is the daemon's architecture, so that is what
# is read.
PLATFORM=()
DAEMON_ARCH="$(docker version --format '{{.Server.Arch}}' 2>/dev/null || true)"
if [ -n "$DAEMON_ARCH" ] && [ "$DAEMON_ARCH" != "amd64" ]; then
  PLATFORM=(--platform linux/amd64)
fi

ARGS=(
  --name "$NAME"
  # `always` rather than `unless-stopped`: this container is infrastructure, and
  # a stop nobody meant to be permanent should not outlive the next boot.
  --restart always
  --memory "$MEMORY"
)
for bind in "${BINDS[@]}"; do
  ARGS+=(-p "$bind:$PORT:$PORT")
done
ARGS+=(
  -v "$CONFIG:/etc/ladder/config.toml:ro"
)
for key in "${KEYS[@]}"; do
  ARGS+=(-e "$key")
done
ARGS+=(${PLATFORM[@]+"${PLATFORM[@]}"} "$IMAGE" --config /etc/ladder/config.toml)

# What the container was built from, so a changed port, cap, key set or image
# is a recreate and an unchanged one is a no-op. The key *values* are not in the
# hash — rotating a key in place is what --recreate is for.
if command -v sha256sum >/dev/null 2>&1; then
  SHA=(sha256sum)
else
  SHA=(shasum -a 256)
fi
spec_hash() {
  printf '%s\n' "${ARGS[@]}" | "${SHA[@]}" | cut -c1-16
}
SPEC="$(spec_hash)"

state() {
  docker inspect -f '{{.State.Status}}' "$NAME" 2>/dev/null || echo "absent"
}
current_spec() {
  docker inspect -f '{{index .Config.Labels "ladder.spec"}}' "$NAME" 2>/dev/null || true
}

if [ "$PULL" -eq 1 ]; then
  if [ "$CHECK" -eq 1 ]; then
    log "[check] would pull $IMAGE"
  else
    log "[pull] $IMAGE"
    docker pull ${PLATFORM[@]+"${PLATFORM[@]}"} "$IMAGE" >/dev/null
    RECREATE=1
  fi
fi

# --- config sync -------------------------------------------------------------
#
# The repository's config replaces this box's when the two differ, but only
# after the image about to run it has accepted it. `--check` on the router
# loads and validates a config and exits without binding, so this costs one
# short-lived container and no traffic.
#
# Order matters: validate, back up, install, then let the normal recreate path
# below pick up the change. Installing first and validating after is how a box
# ends up crash-looping against a file that has already replaced the one that
# worked.
CONFIG_ACTION="none"
config_validates() {
  docker run --rm ${PLATFORM[@]+"${PLATFORM[@]}"} \
    -v "$1:/tmp/candidate.toml:ro" \
    -e LADDER_API_KEY=validation-only \
    "$IMAGE" --config /tmp/candidate.toml --check >/dev/null 2>&1
}

if [ -f "$REPO_CONFIG" ]; then
  if [ ! -f "$CONFIG" ]; then
    CONFIG_ACTION="install"
  elif ! cmp -s "$REPO_CONFIG" "$CONFIG"; then
    CONFIG_ACTION="update"
  fi
fi

if [ "$CONFIG_ACTION" != "none" ]; then
  if [ "$CHECK" -eq 1 ]; then
    log "[check] would $CONFIG_ACTION $CONFIG from $REPO_CONFIG"
  elif config_validates "$REPO_CONFIG"; then
    mkdir -p "$(dirname "$CONFIG")"
    if [ -f "$CONFIG" ]; then
      backup="$CONFIG.$(date -u +%Y%m%dT%H%M%SZ).bak"
      cp "$CONFIG" "$backup"
      log "[backup] $backup"
    fi
    cp "$REPO_CONFIG" "$CONFIG"
    log "[config] $CONFIG_ACTION from $REPO_CONFIG"
    # The container copies nothing from the config at create time — it is a
    # read-only mount — but the router parses it once at startup, so a changed
    # file only takes effect on a restart.
    RECREATE=1
  else
    # The usual cause is a config written for a newer router than this box is
    # running, which `--pull` fixes. Left uninstalled rather than installed and
    # broken: this box keeps serving from the config it already has.
    fail "repository config is not valid for $IMAGE; keeping $CONFIG"
    fail "this box is probably behind; try: ladder-up --pull"
  fi
fi

STATE="$(state)"
ACTION="none"
if [ "$STATE" = "absent" ]; then
  ACTION="create"
elif [ "$RECREATE" -eq 1 ]; then
  ACTION="recreate"
elif [ "$(current_spec)" != "$SPEC" ]; then
  log "[stale] run arguments changed since this container was created"
  ACTION="recreate"
elif [ "$STATE" != "running" ]; then
  ACTION="start"
fi

if [ "$CHECK" -eq 1 ]; then
  log "[check] container is $STATE, would $ACTION"
else
  case "$ACTION" in
    create|recreate)
      [ "$ACTION" = "recreate" ] && docker rm -f "$NAME" >/dev/null 2>&1 || true
      log "[$ACTION] $NAME"
      docker run -d --label "ladder.spec=$SPEC" "${ARGS[@]}" >/dev/null
      ;;
    start)
      log "[start] $NAME (was $STATE)"
      docker start "$NAME" >/dev/null
      ;;
    none)
      log "[ok] $NAME is running"
      ;;
  esac
fi

# Health. A container in `running` proves nothing; ask the router, and ask it
# something only a working key can answer. `/v1/models` is unauthenticated, so a
# check against it passes with any key at all — which is how robot1 sat there
# looking healthy while every real call to it came back 401. A POST of `{}` is
# rejected for auth before it is rejected for shape, so the reply separates
# "alive and the key is right" (400) from "alive and the key is wrong" (401)
# without buying a single upstream token.
[ "$CHECK" -eq 1 ] && [ "$ACTION" != "none" ] && exit 0

probe() {
  curl -s -m 5 -o /dev/null -w '%{http_code}' \
    -X POST "http://$BIND:$PORT/v1/messages" \
    -H "x-api-key: $LADDER_API_KEY" \
    -H 'content-type: application/json' \
    -d '{}' 2>/dev/null || true
}

deadline=$((SECONDS + 45))
while :; do
  code="$(probe)"
  case "$code" in
    400)
      log "[ok] router answering on $BIND:$PORT"
      exit 0
      ;;
    401)
      fail "router is up but rejected LADDER_API_KEY; it must match api_key in $CONFIG"
      exit 1
      ;;
  esac
  if [ "$SECONDS" -ge "$deadline" ]; then
    fail "router did not come up within 45s (last status: ${code:-none})"
    docker logs --tail 20 "$NAME" >&2 2>&1 || true
    exit 1
  fi
  sleep 2
done
